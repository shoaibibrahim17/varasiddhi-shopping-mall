---
import "../styles/global.css";
import { getImage } from "astro:assets";
import { catalogue } from "../data/catalogue";
import { site } from "../data/site";
import CartDrawer from "../components/global/CartDrawer.astro";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
}

const { title, description, canonicalPath = Astro.url.pathname } = Astro.props;

const productMap: Record<string, { title: string; category: string; group: string; thumb: string }> = {};
for (const item of catalogue) {
  const thumb = await getImage({ src: item.image, width: 128, quality: 72 });
  productMap[item.id] = {
    title: item.title,
    category: item.category,
    group: item.group,
    thumb: thumb.src,
  };
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,400;6..96,500;6..96,600&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <meta name="theme-color" content="#FCFAF5" />
    <meta name="robots" content="index, follow" />
    <meta
      name="format-detection"
      content="telephone=no, address=no, email=no"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={canonicalPath} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <div class="topbar" role="banner">
      <div class="topbar__marquee" aria-label="Store announcements">
        <div class="topbar__track">
          <span class="topbar__item">{site.announcement}</span>
          <span class="topbar__item" aria-hidden="true">{site.announcement}</span>
        </div>
      </div>
    </div>

    <slot />

    <CartDrawer />

    <script is:inline type="application/json" data-catalogue-data set:html={JSON.stringify(productMap)} />
    <script>
      import "../scripts/smooth-scroll";
      import "../scripts/animations";
      import "../scripts/carousels";
      import "../scripts/navigation";
      import "../scripts/cart";
    </script>
  <!-- impeccable-live-start -->
<script is:inline src="http://localhost:4321/live.js"></script>
<!-- impeccable-live-end -->
</body>
</html>

<style>
  .topbar {
    background: var(--color-espresso);
    color: var(--color-background);
    min-height: 2.2rem;
    line-height: 1.3;
    overflow: hidden;
  }

  .topbar__marquee {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.2rem;
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }

  .topbar__track {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.8rem;
    width: 100%;
    padding-block: 0.3rem;
    animation: none;
  }

  .topbar__item {
    flex-shrink: 0;
    padding-inline: 0.25rem;
    font-size: 0.67rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0.92;
  }

  @media (prefers-reduced-motion: reduce) {
    .topbar__track {
      animation: none;
    }
  }
</style>

