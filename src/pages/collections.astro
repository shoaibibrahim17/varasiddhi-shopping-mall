---
import Header from "../components/global/Header.astro";
import Footer from "../components/global/Footer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import CatalogueHero from "../components/catalogue/CatalogueHero.astro";
import CategoryNav from "../components/catalogue/CategoryNav.astro";
import CatalogueLook from "../components/catalogue/CatalogueLook.astro";
import EditorialBreak from "../components/catalogue/EditorialBreak.astro";
import VisitCta from "../components/catalogue/VisitCta.astro";
import { getCatalogueItem } from "../data/catalogue";

const sareeEdit = [
  getCatalogueItem("designer-brocade-saree"),
  getCatalogueItem("festive-red-saree"),
  getCatalogueItem("kalamkari-cotton-saree"),
];
const occasionEdit = [
  getCatalogueItem("blush-pink-anarkali"),
  getCatalogueItem("champagne-sherwani-set"),
  getCatalogueItem("royal-blue-anarkali"),
];
const menswearEdit = [
  getCatalogueItem("black-bandhgala"),
  getCatalogueItem("pink-blue-printed-kurta"),
  getCatalogueItem("white-overshirt"),
];
---

<BaseLayout
  title="Collections | Shri Varasiddhi Shopping Mall"
  description="Explore the main fashion collection chapters from Shri Varasiddhi Shopping Mall: sarees, occasion wear, menswear, wedding and everyday casual previews."
  canonicalPath="/collections"
>
  <Header />
  <main id="main-content">
    <CatalogueHero
      eyebrow="Collections"
      title="Find your way through the collection."
      copy="Start with sarees, occasionwear, menswear, wedding dressing or everyday layers, then follow the pieces that hold your attention."
      item={getCatalogueItem("kalamkari-cotton-saree")}
      cta={{ label: "Browse chapters", href: "#saree-edit" }}
      tone="paper"
      imageLabel="Collection lead"
    />
    <CategoryNav items={[
      { label: "The Saree Edit", href: "#saree-edit", detail: "Craft and festive" },
      { label: "Occasion", href: "#occasion-edit", detail: "For family events" },
      { label: "Menswear", href: "#menswear-edit", detail: "Casual to formal" },
      { label: "Everyday", href: "#everyday-edit", detail: "Casual previews" },
      { label: "Visit", href: "#visit", detail: "Adilabad" },
    ]} />
    <CatalogueLook
      id="saree-edit"
      eyebrow="The Saree Edit"
      title="Silk, brocade, cotton and colour."
      copy="A closer look at the sarees, from festive borders to easy cotton weaves."
      items={sareeEdit}
      tone="ivory"
      layout="feature"
      cta={{ label: "Open sarees", href: "/sarees" }}
    />
    <CatalogueLook
      id="occasion-edit"
      eyebrow="Occasion"
      title="Clothes for the gathering on the calendar."
      copy="Anarkalis, shararas, kurtas and sherwanis for the occasions that bring everyone together."
      items={occasionEdit}
      tone="paper"
      layout="mosaic"
      cta={{ label: "Open occasion", href: "/occasion" }}
    />
    <CatalogueLook
      id="menswear-edit"
      eyebrow="Menswear"
      title="From an easy shirt to a wedding layer."
      copy="A considered mix of casual pieces, ethnic sets, tailoring and sherwanis."
      items={menswearEdit}
      tone="espresso"
      layout="feature"
      cta={{ label: "Open men", href: "/men" }}
    />
    <EditorialBreak
      id="everyday-edit"
      eyebrow="Everyday / Casual"
      title="Casual pieces create a lighter close before the visit prompt."
      copy="Everyday and casual are supported by the current catalogue structure and kept as visual previews, not commerce listings."
      item={getCatalogueItem("green-tee-white-shorts")}
      tone="paper"
      imageMode="wide"
      cta={{ label: "Open the full catalogue", href: "/catalogue" }}
    />
    <VisitCta />
  </main>
  <Footer />
</BaseLayout>