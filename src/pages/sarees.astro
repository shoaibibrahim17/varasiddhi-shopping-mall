---
import Header from "../components/global/Header.astro";
import Footer from "../components/global/Footer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/global/ProductCard.astro";
import VisitCta from "../components/catalogue/VisitCta.astro";
import { getCatalogueByCategory } from "../data/catalogue";

const sarees = getCatalogueByCategory("Sarees");
---

<BaseLayout
  title="Saree Collection | Shri Varasiddhi Shopping Mall"
  description="Explore the saree collection from Shri Varasiddhi Shopping Mall — festive, brocade, silk, blockprint and Kalamkari cotton sarees."
  canonicalPath="/sarees"
>
  <Header />
  <main id="main-content">
    <section class="collection-hero">
      <div class="container">
        <p class="collection-hero__eyebrow">Sarees</p>
        <h1 class="collection-hero__title">The saree edit, built around border, weave and colour.</h1>
        <p class="collection-hero__copy">Browse the full saree collection. Add pieces to your enquiry bag, then send them on WhatsApp.</p>
      </div>
    </section>

    <section class="collection-section">
      <div class="container">
        <div class="collection-grid">
          {sarees.map((item, i) => (
            <ProductCard item={item} eager={i < 2} />
          ))}
        </div>
      </div>
    </section>

    <VisitCta />
  </main>
  <Footer />
</BaseLayout>

<style>
  .collection-hero {
    padding-block: clamp(3rem, 6vw, 5rem);
    border-bottom: 1px solid var(--color-line);
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .collection-hero__eyebrow {
    color: var(--color-muted-gold);
    font-size: 0.72rem;
    font-weight: 720;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .collection-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.5vw, 4rem);
    font-weight: 460;
    letter-spacing: -0.03em;
    line-height: 1;
    max-width: 32rem;
    margin-bottom: 1rem;
  }

  .collection-hero__copy {
    color: color-mix(in srgb, currentColor 60%, transparent);
    font-size: 1rem;
    line-height: 1.6;
    max-width: 28rem;
  }

  .collection-section {
    padding-block: clamp(2rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--color-line);
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .collection-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.85rem, 2vw, 1.35rem);
  }
  @media (min-width: 48rem) {
    .collection-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 75rem) {
    .collection-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>


