---
import Header from "../components/global/Header.astro";
import Footer from "../components/global/Footer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import CatalogueHero from "../components/catalogue/CatalogueHero.astro";
import CategoryDial from "../components/catalogue/CategoryDial.astro";
import CatalogueChapter from "../components/catalogue/CatalogueChapter.astro";
import CatalogueShelf from "../components/catalogue/CatalogueShelf.astro";
import EditorialBreak from "../components/catalogue/EditorialBreak.astro";
import VisitCta from "../components/catalogue/VisitCta.astro";
import {
  getCatalogueCategoryGroups,
  getCatalogueItem,
} from "../data/catalogue";

const womenCategories = [
  "Sarees",
  "Cotton Sarees",
  "Occasion Wear",
  "Wedding Wear",
  "Fusion Wear",
] as const;

const menCategories = [
  "Ethnic Wear",
  "Shirts",
  "Casual Wear",
  "Formal Wear",
  "Wedding Wear",
  "Lounge Wear",
] as const;

const womenGroups = getCatalogueCategoryGroups("Women", [...womenCategories]);
const menGroups = getCatalogueCategoryGroups("Men", [...menCategories]);

const totalItems =
  womenGroups.reduce((sum, group) => sum + group.items.length, 0) +
  menGroups.reduce((sum, group) => sum + group.items.length, 0);

let runningNumber = 1;
const womenShelves = womenGroups.map((group) => {
  const shelf = { ...group, startNumber: runningNumber };
  runningNumber += group.items.length;
  return shelf;
});
const menShelves = menGroups.map((group) => {
  const shelf = { ...group, startNumber: runningNumber };
  runningNumber += group.items.length;
  return shelf;
});

const toDialItems = (groups: typeof womenGroups) =>
  groups.map((group) => ({
    label: group.category,
    href: `#${group.slug}`,
    count: group.items.length,
    item: group.items[0],
  }));
---

<BaseLayout
  title="Full Catalogue | Shri Varasiddhi Shopping Mall"
  description="The complete fashion catalogue from Shri Varasiddhi Shopping Mall in Adilabad: every women's and men's piece, organized by category."
  canonicalPath="/catalogue"
>
  <Header />
  <main id="main-content">
    <CatalogueHero
      eyebrow="Catalogue"
      title="Every piece, numbered and organized."
      copy={`All ${totalItems} supplied garments in one index, grouped by department and category.`}
      item={getCatalogueItem("designer-brocade-saree")}
      cta={{ label: "Browse the categories", href: "#categories" }}
      tone="paper"
      imageLabel="Catalogue lead"
    />
    <div id="categories">
      <CategoryDial
        groups={[
          { label: "Women", items: toDialItems(womenGroups) },
          { label: "Men", items: toDialItems(menGroups) },
        ]}
      />
    </div>

    <CatalogueChapter
      id="women"
      eyebrow="Women · Department 01"
      title="Nine pieces from sarees to fusion."
      copy="The complete women's selection, organized by category: silk and blockprint sarees, occasion silhouettes, wedding and fusion pieces."
      tone="paper"
    />
    {
      womenShelves.map((shelf) => (
        <CatalogueShelf
          id={shelf.slug}
          category={shelf.category}
          items={shelf.items}
          startNumber={shelf.startNumber}
          tone="paper"
        />
      ))
    }

    <EditorialBreak
      id="mens-break"
      eyebrow="Department 02"
      title="The men's edit, from kurta sets to sherwanis."
      copy="Sixteen pieces moving through ethnicwear, shirts, casual and formal tailoring, wedding dressing and loungewear."
      item={getCatalogueItem("ivory-sherwani")}
      tone="espresso"
      cta={{ label: "Open the men's edit", href: "#men" }}
      imageMode="wide"
    />

    <CatalogueChapter
      id="men"
      eyebrow="Men · Department 02"
      title="Sixteen pieces from ethnic to lounge."
      copy="The complete men's selection, organized by category: ethnicwear, shirts, casual, formal, wedding and loungewear."
      tone="ivory"
    />
    {
      menShelves.map((shelf) => (
        <CatalogueShelf
          id={shelf.slug}
          category={shelf.category}
          items={shelf.items}
          startNumber={shelf.startNumber}
          tone="ivory"
        />
      ))
    }

    <VisitCta />
  </main>
  <Footer />
</BaseLayout>
