---
import { Image } from "astro:assets";
import { ArrowLeft, ArrowRight, Pause, Play } from "lucide-astro";
import Header from "../components/global/Header.astro";
import Footer from "../components/global/Footer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductRail from "../components/global/ProductRail.astro";
import VisitCta from "../components/catalogue/VisitCta.astro";
import StoryBubbles from "../components/home/StoryBubbles.astro";
import SplashScreen from "../components/SplashScreen.astro";
import desktopCampaignOne from "../assets/carousel-web-1.png";
import desktopCampaignTwo from "../assets/carousel-web-2.png";
import mobileCampaignOne from "../assets/mobile-carousel-01.png";
import mobileCampaignTwo from "../assets/mobile-carousel-02.png";
import {
  getCatalogueByCategory,
  getCatalogueItem,
} from "../data/catalogue";

const heroSlides = [
  {
    id: "campaign-one",
    desktop: desktopCampaignOne,
    mobile: mobileCampaignOne,
    alt: "Shri Varasiddhi fashion campaign artwork",
    href: "/catalogue",
    linkLabel: "Explore the Shri Varasiddhi collection",
  },
  {
    id: "campaign-two",
    desktop: desktopCampaignTwo,
    mobile: mobileCampaignTwo,
    alt: "Shri Varasiddhi fashion campaign artwork",
    href: "/collections",
    linkLabel: "Explore the featured collections",
  },
];

const categoryTiles = [
  { label: "Sarees", href: "/sarees", item: getCatalogueItem("designer-brocade-saree"), detail: "Silk, brocade and cotton" },
  { label: "Women", href: "/women", item: getCatalogueItem("blush-pink-anarkali"), detail: "Anarkalis, shararas and fusion" },
  { label: "Men", href: "/men", item: getCatalogueItem("navy-embroidered-jacket-kurta"), detail: "Kurtas, shirts and tailoring" },
];

const sareeEdit = [
  ...getCatalogueByCategory("Sarees"),
  ...getCatalogueByCategory("Cotton Sarees"),
].slice(0, 7);
const newIn = [
  getCatalogueItem("sparkle-pink-coord"),
  getCatalogueItem("maroon-silk-saree"),
  getCatalogueItem("sky-blue-button-down-shirt"),
  getCatalogueItem("black-bandhgala"),
  getCatalogueItem("kalamkari-cotton-saree"),
  getCatalogueItem("champagne-sherwani-set"),
];
---

<BaseLayout
  title="Shri Varasiddhi Shopping Mall | Fashion Catalogue in Adilabad"
  description="See sarees, women's fashion, men's fashion and occasionwear from Shri Varasiddhi Shopping Mall in Adilabad. Save pieces for a WhatsApp enquiry."
>
  <SplashScreen />
  <Header />
  <main id="main-content">
    <StoryBubbles />

    <section class="hero" data-carousel aria-label="Featured campaigns">
      <div class="hero__track" data-carousel-track>
        {heroSlides.map((slide, i) => (
          <article class="hero__slide" data-carousel-item>
            <picture class="hero__media">
              <source media="(max-width: 47.99rem)" srcset={slide.mobile.src} />
              <Image
                class="hero__image"
                src={slide.desktop}
                alt={slide.alt}
                widths={[720, 1080, 1440, 1920]}
                sizes="100vw"
                quality={86}
                loading={i === 0 ? "eager" : "lazy"}
                fetchpriority={i === 0 ? "high" : undefined}
              />
            </picture>
            <a class="hero__explore" href={slide.href} aria-label={slide.linkLabel}>
              <span class="sr-only">{slide.linkLabel}</span>
            </a>
          </article>
        ))}
      </div>
      <div class="hero__controls">
        <button type="button" data-carousel-prev aria-label="Previous campaign">
          <ArrowLeft size={17} stroke-width={1.5} aria-hidden="true" />
        </button>
        <span data-carousel-counter class="hero__counter">01 — 03</span>
        <button type="button" data-carousel-next aria-label="Next campaign">
          <ArrowRight size={17} stroke-width={1.5} aria-hidden="true" />
        </button>
        <button type="button" class="hero__pause" data-carousel-toggle aria-label="Pause campaign rotation" aria-pressed="false">
          <Pause class="hero__pause-icon" size={15} stroke-width={1.7} aria-hidden="true" />
          <Play class="hero__play-icon" size={15} stroke-width={1.7} aria-hidden="true" />
        </button>
      </div>
    </section>

    <a class="skip-link" href="#category-shop" aria-label="Skip carousel">Skip carousel</a>

    <section class="category-shop" aria-labelledby="category-shop-title">
      <div class="category-shop__head container">
        <p class="category-shop__eyebrow">Departments</p>
        <h2 id="category-shop-title">Start with what you are dressing for.</h2>
      </div>
      <div class="category-shop__grid container">
        {categoryTiles.map((tile) => (
          <a class="category-tile" href={tile.href}>
            <span class="category-tile__media asset-frame asset-frame--fashion-crop" style={`--crop-x: ${tile.item.crop.x}%; --crop-y: ${tile.item.crop.y}%; --crop-scale: ${tile.item.crop.scale};`}>
              <Image
                class="asset-frame__image"
                src={tile.item.image}
                alt=""
                widths={[260, 420, 620]}
                sizes="(max-width: 768px) 47vw, 23vw"
                quality={78}
                loading="lazy"
              />
            </span>
            <span class="category-tile__text">
              <strong>{tile.label}</strong>
              <span>{tile.detail}</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <ProductRail title="Start here" items={newIn} viewAllHref="/catalogue" mobileHint />

    <ProductRail title="Sarees" items={sareeEdit} viewAllHref="/sarees" />
    <VisitCta />
  </main>
  <Footer />
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(0.5rem, 1.5vw, 1.1rem) var(--gutter) clamp(2.2rem, 4vw, 3.8rem);
    background: var(--color-paper);
    color: var(--color-paper);
  }

  .hero__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .hero__track::-webkit-scrollbar {
    display: none;
  }

  .hero__slide {
    position: relative;
    aspect-ratio: 1672 / 941;
    flex: 0 0 100%;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-gold) 75%, transparent);
    scroll-snap-align: start;
  }

  .hero__media,
  .hero__image {
    position: absolute;
    inset: 0;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__explore {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
  }

  .hero__explore:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: -0.5rem;
  }

  .category-shop__eyebrow,
  .catalogue-note p {
    color: var(--color-gold);
    font-size: 0.66rem;
    font-weight: 760;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .hero__controls {
    position: absolute;
    right: clamp(1.8rem, 4vw, 3.5rem);
    bottom: clamp(1.8rem, 4vw, 3.5rem);
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .hero__controls button {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid color-mix(in srgb, var(--color-paper) 35%, transparent);
    border-radius: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .hero__controls button:hover,
  .hero__controls button:focus-visible {
    border-color: var(--color-paper);
    background: color-mix(in srgb, var(--color-paper) 14%, transparent);
  }

  .hero__pause {
    margin-left: 0.25rem;
  }

  .hero__play-icon {
    display: none;
  }

  .hero.is-paused .hero__pause-icon {
    display: none;
  }

  .hero.is-paused .hero__play-icon {
    display: block;
  }

  .hero__counter {
    color: color-mix(in srgb, var(--color-paper) 72%, transparent);
    font-size: 0.66rem;
    font-weight: 760;
    letter-spacing: 0.1em;
  }

  @media (max-width: 47.99rem) {
    .hero__slide {
      aspect-ratio: 2 / 3;
    }
  }

  .category-shop {
    padding-block: clamp(3rem, 6vw, 5rem);
    border-bottom: 1px solid var(--color-line);
    background: var(--color-paper);
  }

  .category-shop__head {
    display: grid;
    gap: 0.7rem;
    margin-bottom: clamp(1.4rem, 2.5vw, 2rem);
  }

  .category-shop__head h2,
  .catalogue-note h2 {
    max-width: 15ch;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.2vw, 2.9rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.96;
  }

  .category-shop__head h2::before {
    display: block;
    width: 2.5rem;
    height: 2px;
    margin-bottom: 0.8rem;
    background: var(--color-gold);
    content: "";
  }

  .category-shop__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.8rem, 2vw, 1.25rem);
  }

  @media (min-width: 48rem) {
    .category-shop__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .category-tile {
    display: grid;
    gap: 0.62rem;
    color: inherit;
    text-decoration: none;
    transition:
      opacity 180ms var(--ease-out),
      transform 150ms var(--ease-out);
  }

  .category-tile:hover,
  .category-tile:focus-visible {
    opacity: 0.85;
    transform: scale(1.02);
  }

  .category-tile:active,
  .category-tile:focus-visible:active {
    opacity: 0.7;
    transform: scale(0.98);
  }

  .category-tile__media {
    --asset-ratio: 3 / 4;
  }

  .category-tile__text {
    display: grid;
    gap: 0.18rem;
  }

  .category-tile__text strong {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2vw, 1.55rem);
    font-weight: 520;
    line-height: 1;
  }

  .category-tile__text span {
    color: var(--color-description);
    font-size: 0.76rem;
    line-height: 1.35;
  }

  @media (max-width: 47.99rem) {
    .hero {
      padding-inline: 0.65rem;
    }

    .hero__slide {
      min-height: min(39rem, 132vw);
    }

    .hero__media::after {
      background:
        linear-gradient(to bottom, color-mix(in srgb, var(--color-espresso) 12%, transparent), color-mix(in srgb, var(--color-espresso) 76%, transparent) 88%),
        linear-gradient(to right, color-mix(in srgb, var(--color-espresso) 28%, transparent), transparent);
    }

    .hero__content {
      padding-inline: 1.4rem;
    }

    .hero__poster-mark {
      top: 1.2rem;
      right: 1.2rem;
    }

    .hero__poster-copy {
      max-width: 6.5rem;
      font-size: 0.52rem;
    }

    .hero__controls {
      left: 1.4rem;
      right: auto;
      bottom: 1.35rem;
    }
  }

  @media (min-width: 48rem) {
    .category-shop__head {
      grid-template-columns: 0.8fr 1.2fr;
      align-items: end;
    }

    .catalogue-note__inner {
      grid-template-columns: 0.42fr 1fr auto;
      align-items: end;
    }
  }
</style>
