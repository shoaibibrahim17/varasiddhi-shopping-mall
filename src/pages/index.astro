---
import Header from "../components/global/Header.astro";
import Footer from "../components/global/Footer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductRail from "../components/global/ProductRail.astro";
import VisitCta from "../components/catalogue/VisitCta.astro";
import StoryBubbles from "../components/home/StoryBubbles.astro";
import { Image } from "astro:assets";
import {
  catalogue,
  getCatalogueByCategory,
  getCatalogueByGroup,
} from "../data/catalogue";

const heroSlides = [
  { id: "festive-red-saree", eyebrow: "New arrivals", title: "The Saree Edit", cta: "Shop Sarees", href: "/sarees" },
  { id: "mustard-sharara-set", eyebrow: "Celebration dressing", title: "Occasion & Festive", cta: "Explore", href: "/occasion" },
  { id: "classic-white-kurta", eyebrow: "Sharp tailoring", title: "The Men's Edit", cta: "Shop Men", href: "/men" },
].map((slide) => ({
  ...slide,
  item: catalogue.find((c) => c.id === slide.id)!,
}));

const categories = [
  { label: "Sarees", href: "/sarees", items: getCatalogueByCategory("Sarees") },
  { label: "Occasion Wear", href: "/occasion", items: getCatalogueByCategory("Occasion Wear") },
  { label: "Wedding Wear", href: "/occasion", items: getCatalogueByCategory("Wedding Wear") },
  { label: "Fusion Wear", href: "/women", items: getCatalogueByCategory("Fusion Wear") },
  { label: "Ethnic Wear", href: "/men", items: getCatalogueByCategory("Ethnic Wear") },
  { label: "Casual Wear", href: "/men", items: getCatalogueByCategory("Casual Wear") },
  { label: "Shirts", href: "/men", items: getCatalogueByCategory("Shirts") },
  { label: "Formal Wear", href: "/men", items: getCatalogueByCategory("Formal Wear") },
];

const sareeEdit = getCatalogueByCategory("Sarees").slice(0, 6);
const occasionEdit = [
  ...getCatalogueByCategory("Occasion Wear"),
  ...getCatalogueByCategory("Wedding Wear"),
].slice(0, 6);
const menEdit = getCatalogueByGroup("Men").slice(0, 6);
---

<BaseLayout
  title="Shri Varasiddhi Shopping Mall | Fashion in Adilabad"
  description="Explore sarees, women's fashion, men's fashion and occasion wear from Shri Varasiddhi Shopping Mall in Adilabad, Telangana."
>
  <Header />
  <main id="main-content">
    <!-- ─── Story Bubbles ─── -->
    <StoryBubbles />

    <!-- ─── Hero Editorial Banner ─── -->
    <section class="hero" data-carousel aria-label="Featured collections">
      <div class="hero__track" data-carousel-track>
        {heroSlides.map((slide, i) => (
          <div class="hero__slide" data-carousel-item>
            <span class="hero__bg asset-frame asset-frame--fashion-crop" style={`--crop-x: ${slide.item.crop.x}%; --crop-y: ${slide.item.crop.y}%; --crop-scale: ${slide.item.crop.scale};`}>
              <Image
                class="asset-frame__image"
                src={slide.item.image}
                alt=""
                widths={[720, 1080, 1440, 1920]}
                sizes="100vw"
                quality={80}
                loading={i === 0 ? "eager" : "lazy"}
                fetchpriority={i === 0 ? "high" : undefined}
              />
            </span>
            <div class="hero__content container">
              <p class="hero__eyebrow">{slide.eyebrow}</p>
              <h2 class="hero__title font-serif">{slide.title}</h2>
              <a class="hero__cta" href={slide.href}>{slide.cta}</a>
            </div>
          </div>
        ))}
      </div>
      <div class="hero__controls">
        <button type="button" data-carousel-prev aria-label="Previous slide">&larr;</button>
        <span data-carousel-counter class="hero__counter">01 — 03</span>
        <button type="button" data-carousel-next aria-label="Next slide">&rarr;</button>
      </div>
    </section>

    <!-- ─── Saree Edit ─── -->
    <ProductRail
      title="The Saree Edit"
      items={sareeEdit}
      viewAllHref="/sarees"
    />

    <!-- ─── Promo Strip ─── -->
    <section class="promo-strip" aria-label="Store promotion">
      <div class="promo-strip__inner container">
        <p class="promo-strip__title">Visit us in Adilabad</p>
        <p class="promo-strip__text">See the full collection in person. Our team will help you find the right piece for every occasion.</p>
        <a class="button-primary promo-strip__cta" href="/visit">Plan your visit</a>
      </div>
    </section>

    <!-- ─── Occasion & Festive ─── -->
    <ProductRail
      title="Occasion & Festive"
      items={occasionEdit}
      viewAllHref="/occasion"
    />

    <!-- ─── Men's Edit ─── -->
    <ProductRail
      title="The Men's Edit"
      items={menEdit}
      viewAllHref="/men"
    />

    <VisitCta />
  </main>
  <Footer />
</BaseLayout>

<style>
  /* ─── Category Circles ─── */
  .circle-nav {
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--color-line);
    background: var(--color-paper);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .circle-nav__inner {
    display: flex;
    gap: clamp(1.2rem, 3vw, 2.5rem);
    justify-content: center;
  }

  .circle-nav__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
  }

  .circle-nav__circle {
    display: grid;
    place-items: center;
    width: clamp(3.5rem, 8vw, 5rem);
    height: clamp(3.5rem, 8vw, 5rem);
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: var(--color-stone);
    transition: border-color var(--duration-fast) var(--ease-out), transform var(--duration-hover) var(--ease-out);
  }

  .circle-nav__link:hover .circle-nav__circle {
    border-color: var(--color-gold);
    border-width: 2px;
    transform: scale(1.05);
  }

  .circle-nav__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .circle-nav__label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* ─── Hero Editorial Banner ─── */
  .hero {
    position: relative;
    background: var(--color-title);
    color: var(--color-background);
    overflow: hidden;
  }

  .hero__track {
    display: flex;
    scroll-snap-type: x mandatory;
  }

  .hero__slide {
    position: relative;
    flex: 0 0 100%;
    scroll-snap-align: start;
    min-height: clamp(60vh, 72vw, 82vh);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    --asset-ratio: 3 / 4;
  }

  .hero__bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-title) 45%, transparent) 0%,
      color-mix(in srgb, var(--color-title) 20%, transparent) 45%,
      color-mix(in srgb, var(--color-title) 65%, transparent) 100%
    );
  }

  .hero__content {
    position: absolute;
    bottom: clamp(2.5rem, 8vw, 6rem);
    left: var(--gutter);
    right: var(--gutter);
    z-index: 2;
    max-width: 52rem;
  }

  .hero__eyebrow {
    color: var(--color-gold);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 0.9rem;
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 5.6vw, 4.8rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin-bottom: 1.25rem;
  }

  .hero__cta {
    display: inline-flex;
    min-height: 2.75rem;
    padding: 0.7rem 1.6rem;
    background: var(--color-background);
    color: var(--color-title);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid var(--color-background);
    transition:
      background-color 180ms var(--ease-out),
      color 180ms var(--ease-out),
      border-color 180ms var(--ease-out),
      transform 300ms var(--ease-out);
  }

  .hero__cta:hover {
    background: var(--color-gold);
    border-color: var(--color-gold);
    color: var(--color-title);
    transform: translateY(-1px);
  }

  .hero__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 1rem var(--gutter);
    background: var(--color-title);
    color: var(--color-background);
  }

  .hero__controls button {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid color-mix(in srgb, var(--color-background) 22%, transparent);
    border-radius: 50%;
    background: transparent;
    color: inherit;
    font-size: 1rem;
    cursor: pointer;
    transition: border-color 180ms var(--ease-out), color 180ms var(--ease-out);
  }

  .hero__controls button:hover {
    border-color: var(--color-gold);
    color: var(--color-gold);
  }

  .hero__counter {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted-gold);
  }

  /* ─── Promo Strip ─── */
  .promo-strip {
    padding-block: clamp(3rem, 6vw, 5rem);
    background: var(--color-stone);
    color: var(--color-ink);
    text-align: center;
  }

  .promo-strip__inner {
    display: grid;
    gap: 1rem;
    justify-items: center;
  }

  .promo-strip__title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.5vw, 3rem);
    font-weight: 460;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .promo-strip__text {
    max-width: 32rem;
    color: color-mix(in srgb, currentColor 65%, transparent);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .promo-strip__cta {
    margin-top: 0.5rem;
  }
</style>
