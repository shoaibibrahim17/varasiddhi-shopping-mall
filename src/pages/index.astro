---
import { Image } from "astro:assets";
import { ArrowLeft, ArrowRight, Pause, Play } from "lucide-astro";
import Header from "../components/global/Header.astro";
import Footer from "../components/global/Footer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductRail from "../components/global/ProductRail.astro";
import VisitCta from "../components/catalogue/VisitCta.astro";
import StoryBubbles from "../components/home/StoryBubbles.astro";
import SplashScreen from "../components/SplashScreen.astro";
import {
  catalogue,
  getCatalogueByCategory,
  getCatalogueByGroup,
  getCatalogueItem,
} from "../data/catalogue";

const heroSlides = [
  {
    id: "festive-red-saree",
    campaign: "The Saree Edit",
    edition: "Festive dressing",
    eyebrow: "Catalogue preview",
    title: "Shri Varasiddhi Shopping Mall",
    copy: "A mobile-first fashion catalogue for sarees, occasion wear and menswear in Adilabad.",
    cta: "Browse catalogue",
    href: "/catalogue",
  },
  {
    id: "mustard-sharara-set",
    campaign: "Occasion Edit",
    edition: "Celebration dressing",
    eyebrow: "Occasion edit",
    title: "Celebration dressing, selected by look.",
    copy: "Save pieces to your enquiry bag and share the selection on WhatsApp.",
    cta: "Open occasion",
    href: "/occasion",
  },
  {
    id: "classic-white-kurta",
    campaign: "Menswear Edit",
    edition: "Ethnic and formal",
    eyebrow: "Menswear",
    title: "Ethnic, formal and everyday menswear.",
    copy: "The current catalogue is structured for future online ordering without showing a checkout too early.",
    cta: "Open men",
    href: "/men",
  },
].map((slide) => ({
  ...slide,
  item: catalogue.find((c) => c.id === slide.id)!,
}));

const categoryTiles = [
  { label: "Sarees", href: "/sarees", item: getCatalogueItem("designer-brocade-saree"), detail: "Silk, brocade and festive colour" },
  { label: "Women", href: "/women", item: getCatalogueItem("blush-pink-anarkali"), detail: "Occasion and fusion previews" },
  { label: "Men", href: "/men", item: getCatalogueItem("navy-embroidered-jacket-kurta"), detail: "Ethnic, shirts and formalwear" },
  { label: "Wedding", href: "/occasion", item: getCatalogueItem("ivory-sherwani"), detail: "Ceremonial looks across the family" },
];

const sareeEdit = [
  ...getCatalogueByCategory("Sarees"),
  ...getCatalogueByCategory("Cotton Sarees"),
].slice(0, 7);
const occasionEdit = [
  ...getCatalogueByCategory("Occasion Wear"),
  ...getCatalogueByCategory("Wedding Wear"),
].slice(0, 7);
const menEdit = getCatalogueByGroup("Men").slice(0, 8);
const newIn = [
  getCatalogueItem("sparkle-pink-coord"),
  getCatalogueItem("maroon-silk-saree"),
  getCatalogueItem("sky-blue-button-down-shirt"),
  getCatalogueItem("black-bandhgala"),
  getCatalogueItem("kalamkari-cotton-saree"),
  getCatalogueItem("champagne-sherwani-set"),
];
---

<BaseLayout
  title="Shri Varasiddhi Shopping Mall | Fashion Catalogue in Adilabad"
  description="Browse the Shri Varasiddhi Shopping Mall catalogue for sarees, women's fashion, men's fashion and occasion wear. Send selected pieces by WhatsApp enquiry."
>
  <SplashScreen />
  <Header />
  <main id="main-content">
    <StoryBubbles />

    <section class="hero" data-carousel aria-label="Featured campaigns">
      <div class="hero__track" data-carousel-track>
        {heroSlides.map((slide, i) => (
          <article class="hero__slide" data-carousel-item>
            <div class="hero__poster-mark" aria-hidden="true">
              <span class="hero__poster-index">{String(i + 1).padStart(2, "0")}</span>
              <span class="hero__poster-rule"></span>
              <span class="hero__poster-copy">{slide.campaign}</span>
            </div>
            <div class="hero__media" aria-hidden="true">
              <span class="hero__image asset-frame asset-frame--fashion-crop" style={`--crop-x: ${slide.item.crop.x}%; --crop-y: ${slide.item.crop.y}%; --crop-scale: ${slide.item.crop.scale};`}>
                <Image
                  class="asset-frame__image"
                  src={slide.item.image}
                  alt=""
                  widths={[720, 1080, 1440, 1920]}
                  sizes="100vw"
                  quality={82}
                  loading={i === 0 ? "eager" : "lazy"}
                  fetchpriority={i === 0 ? "high" : undefined}
                />
              </span>
            </div>
            <div class="hero__content container">
              <div class="hero__campaign-tag">
                <span class="hero__campaign-dot" aria-hidden="true"></span>
                <p class="hero__eyebrow">{slide.campaign} / {slide.edition}</p>
              </div>
              {i === 0 ? (
                <h1 class="hero__title hero__title--brand">
                  <span>Shri Varasiddhi</span>
                  <em>Shopping Mall</em>
                </h1>
              ) : (
                <h2 class="hero__title">{slide.title}</h2>
              )}
              <p class="hero__copy">{slide.copy}</p>
              <div class="hero__actions">
                <a class="hero__cta" href={slide.href}>{slide.cta}</a>
                <a class="hero__link" href="/visit">Visit store</a>
              </div>
            </div>
          </article>
        ))}
      </div>
      <div class="hero__controls">
        <button type="button" data-carousel-prev aria-label="Previous campaign">
          <ArrowLeft size={17} stroke-width={1.5} aria-hidden="true" />
        </button>
        <span data-carousel-counter class="hero__counter">01 — 03</span>
        <button type="button" data-carousel-next aria-label="Next campaign">
          <ArrowRight size={17} stroke-width={1.5} aria-hidden="true" />
        </button>
        <button type="button" class="hero__pause" data-carousel-toggle aria-label="Pause campaign rotation" aria-pressed="false">
          <Pause class="hero__pause-icon" size={15} stroke-width={1.7} aria-hidden="true" />
          <Play class="hero__play-icon" size={15} stroke-width={1.7} aria-hidden="true" />
        </button>
      </div>
    </section>

    <section class="category-shop" aria-labelledby="category-shop-title">
      <div class="category-shop__head container">
        <p class="category-shop__eyebrow">Shop by department</p>
        <h2 id="category-shop-title">Compact routes into the catalogue.</h2>
      </div>
      <div class="category-shop__grid container">
        {categoryTiles.map((tile) => (
          <a class="category-tile" href={tile.href}>
            <span class="category-tile__media asset-frame asset-frame--fashion-crop" style={`--crop-x: ${tile.item.crop.x}%; --crop-y: ${tile.item.crop.y}%; --crop-scale: ${tile.item.crop.scale};`}>
              <Image
                class="asset-frame__image"
                src={tile.item.image}
                alt=""
                widths={[260, 420, 620]}
                sizes="(max-width: 768px) 47vw, 23vw"
                quality={78}
                loading="lazy"
              />
            </span>
            <span class="category-tile__text">
              <strong>{tile.label}</strong>
              <span>{tile.detail}</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <ProductRail title="New catalogue picks" items={newIn} viewAllHref="/catalogue" />

    <section class="catalogue-note" aria-label="Ordering roadmap">
      <div class="catalogue-note__inner container">
        <p>WhatsApp enquiry now</p>
        <h2>Built for online ordering later, without pretending checkout is live today.</h2>
        <a href="/catalogue">Open full catalogue</a>
      </div>
    </section>

    <ProductRail title="The saree edit" items={sareeEdit} viewAllHref="/sarees" />
    <ProductRail title="Occasion and wedding" items={occasionEdit} viewAllHref="/occasion" />
    <ProductRail title="Menswear edit" items={menEdit} viewAllHref="/men" />

    <VisitCta />
  </main>
  <Footer />
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(0.75rem, 2vw, 1.6rem) var(--gutter) clamp(2.6rem, 5vw, 4.5rem);
    background: var(--color-paper);
    color: var(--color-paper);
  }

  .hero__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .hero__track::-webkit-scrollbar {
    display: none;
  }

  .hero__slide {
    position: relative;
    display: grid;
    min-height: clamp(28rem, 58vw, 42rem);
    flex: 0 0 100%;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-gold) 75%, transparent);
    scroll-snap-align: start;
  }

  .hero__media,
  .hero__image {
    position: absolute;
    inset: 0;
  }

  .hero__image {
    --asset-ratio: auto;
  }

  .hero__media::after {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, color-mix(in srgb, var(--color-espresso) 82%, transparent), color-mix(in srgb, var(--color-espresso) 42%, transparent) 42%, transparent 76%),
      linear-gradient(to bottom, color-mix(in srgb, var(--color-espresso) 24%, transparent), color-mix(in srgb, var(--color-espresso) 18%, transparent));
    content: "";
  }

  .hero__slide::before {
    position: absolute;
    inset: clamp(0.55rem, 1.4vw, 1.1rem);
    z-index: 2;
    border: 1px solid color-mix(in srgb, var(--color-paper) 64%, transparent);
    content: "";
    pointer-events: none;
  }

  .hero__poster-mark {
    position: absolute;
    top: clamp(1.8rem, 4vw, 3.5rem);
    right: clamp(1.8rem, 4vw, 3.5rem);
    z-index: 2;
    display: grid;
    justify-items: end;
    gap: 0.6rem;
    color: color-mix(in srgb, var(--color-paper) 76%, transparent);
    text-align: right;
  }

  .hero__poster-index {
    color: var(--color-gold);
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.8rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 0.8;
  }

  .hero__poster-rule {
    width: 3.5rem;
    height: 1px;
    background: color-mix(in srgb, var(--color-paper) 55%, transparent);
  }

  .hero__poster-copy {
    max-width: 8rem;
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    display: grid;
    align-content: end;
    gap: 0.85rem;
    padding-block: clamp(4.5rem, 11vw, 8rem) clamp(4.7rem, 9vw, 7rem);
    padding-inline: clamp(1.5rem, 7vw, 8rem);
  }

  .hero__campaign-tag {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .hero__campaign-dot {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--color-gold);
    box-shadow: 0 0 0 0.3rem color-mix(in srgb, var(--color-gold) 18%, transparent);
  }

  .hero__eyebrow,
  .category-shop__eyebrow,
  .catalogue-note p {
    color: var(--color-gold);
    font-size: 0.66rem;
    font-weight: 760;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .hero__title {
    max-width: 8.5ch;
    font-family: var(--font-display);
    font-size: clamp(3.05rem, 11vw, 6.7rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 0.84;
  }

  .hero__title--brand {
    max-width: 8.5ch;
  }

  .hero__title--brand span,
  .hero__title--brand em {
    display: block;
  }

  .hero__title--brand em {
    margin-top: 1.2rem;
    color: var(--color-gold);
    font-family: var(--font-sans);
    font-size: clamp(0.62rem, 1.2vw, 0.88rem);
    font-style: normal;
    font-weight: 600;
    letter-spacing: 0.22em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .hero__copy {
    max-width: 31rem;
    color: color-mix(in srgb, var(--color-paper) 78%, transparent);
    font-size: clamp(0.96rem, 1.4vw, 1.12rem);
    line-height: 1.55;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1rem;
    align-items: center;
    margin-top: 0.3rem;
  }

  .hero__cta,
  .hero__link {
    display: inline-flex;
    min-height: 2.8rem;
    align-items: center;
    justify-content: center;
    font-size: 0.72rem;
    font-weight: 760;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .hero__cta {
    padding: 0.8rem 1.05rem;
    border: 1px solid var(--color-paper);
    background: var(--color-paper);
    color: var(--color-espresso);
  }

  .hero__link {
    color: var(--color-paper);
    text-decoration: underline;
    text-underline-offset: 0.35em;
  }

  .hero__controls {
    position: absolute;
    right: clamp(1.8rem, 4vw, 3.5rem);
    bottom: clamp(1.8rem, 4vw, 3.5rem);
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .hero__controls button {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid color-mix(in srgb, var(--color-paper) 35%, transparent);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .hero__controls button:hover,
  .hero__controls button:focus-visible {
    border-color: var(--color-paper);
    background: color-mix(in srgb, var(--color-paper) 14%, transparent);
  }

  .hero__pause {
    margin-left: 0.25rem;
  }

  .hero__play-icon {
    display: none;
  }

  .hero.is-paused .hero__pause-icon {
    display: none;
  }

  .hero.is-paused .hero__play-icon {
    display: block;
  }

  .hero__counter {
    color: color-mix(in srgb, var(--color-paper) 72%, transparent);
    font-size: 0.66rem;
    font-weight: 760;
    letter-spacing: 0.1em;
  }

  .category-shop {
    padding-block: clamp(2.4rem, 5vw, 4.5rem);
    border-bottom: 1px solid var(--color-line);
    background: var(--color-paper);
  }

  .category-shop__head {
    display: grid;
    gap: 0.55rem;
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }

  .category-shop__head h2,
  .catalogue-note h2 {
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.4vw, 3.1rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 0.98;
  }

  .category-shop__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.8vw, 1.25rem);
  }

  .category-tile {
    display: grid;
    gap: 0.62rem;
    color: inherit;
    text-decoration: none;
  }

  .category-tile__media {
    --asset-ratio: 3 / 4;
  }

  .category-tile__text {
    display: grid;
    gap: 0.18rem;
  }

  .category-tile__text strong {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2vw, 1.55rem);
    font-weight: 520;
    line-height: 1;
  }

  .category-tile__text span {
    color: var(--color-description);
    font-size: 0.76rem;
    line-height: 1.35;
  }

  .catalogue-note {
    padding-block: clamp(2.8rem, 6vw, 5.6rem);
    background: var(--color-maroon);
    color: var(--color-paper);
  }

  .catalogue-note__inner {
    display: grid;
    gap: 0.8rem;
  }

  .catalogue-note h2 {
    max-width: 24ch;
  }

  .catalogue-note a {
    width: fit-content;
    color: var(--color-paper);
    font-size: 0.72rem;
    font-weight: 760;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-underline-offset: 0.35em;
  }

  @media (max-width: 47.99rem) {
    .hero {
      padding-inline: 0.65rem;
    }

    .hero__slide {
      min-height: min(39rem, 132vw);
    }

    .hero__media::after {
      background:
        linear-gradient(to bottom, color-mix(in srgb, var(--color-espresso) 12%, transparent), color-mix(in srgb, var(--color-espresso) 76%, transparent) 88%),
        linear-gradient(to right, color-mix(in srgb, var(--color-espresso) 28%, transparent), transparent);
    }

    .hero__content {
      padding-inline: 1.4rem;
    }

    .hero__poster-mark {
      top: 1.2rem;
      right: 1.2rem;
    }

    .hero__poster-copy {
      max-width: 6.5rem;
      font-size: 0.52rem;
    }

    .hero__controls {
      left: 1.4rem;
      right: auto;
      bottom: 1.35rem;
    }
  }

  @media (min-width: 48rem) {
    .hero__content {
      align-content: center;
    }

    .category-shop__head {
      grid-template-columns: 0.8fr 1.2fr;
      align-items: end;
    }

    .category-shop__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .catalogue-note__inner {
      grid-template-columns: 0.42fr 1fr auto;
      align-items: end;
    }
  }
</style>
