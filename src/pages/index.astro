---
import Header from "../components/global/Header.astro";
import Footer from "../components/global/Footer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductRail from "../components/global/ProductRail.astro";
import VisitCta from "../components/catalogue/VisitCta.astro";
import StoryBubbles from "../components/home/StoryBubbles.astro";
import SplashScreen from "../components/SplashScreen.astro";
import { Image } from "astro:assets";
import {
  catalogue,
  getCatalogueByCategory,
  getCatalogueByGroup,
} from "../data/catalogue";

const heroSlides = [
  { id: "festive-red-saree", eyebrow: "New arrivals", title: "The Saree Edit", cta: "Shop Sarees", href: "/sarees" },
  { id: "mustard-sharara-set", eyebrow: "Celebration dressing", title: "Occasion & Festive", cta: "Explore", href: "/occasion" },
  { id: "classic-white-kurta", eyebrow: "Sharp tailoring", title: "The Men's Edit", cta: "Shop Men", href: "/men" },
].map((slide) => ({
  ...slide,
  item: catalogue.find((c) => c.id === slide.id)!,
}));

const categories = [
  { label: "Sarees", href: "/sarees", items: getCatalogueByCategory("Sarees") },
  { label: "Occasion Wear", href: "/occasion", items: getCatalogueByCategory("Occasion Wear") },
  { label: "Wedding Wear", href: "/occasion", items: getCatalogueByCategory("Wedding Wear") },
  { label: "Fusion Wear", href: "/women", items: getCatalogueByCategory("Fusion Wear") },
  { label: "Ethnic Wear", href: "/men", items: getCatalogueByCategory("Ethnic Wear") },
  { label: "Casual Wear", href: "/men", items: getCatalogueByCategory("Casual Wear") },
  { label: "Shirts", href: "/men", items: getCatalogueByCategory("Shirts") },
  { label: "Formal Wear", href: "/men", items: getCatalogueByCategory("Formal Wear") },
];

const sareeEdit = getCatalogueByCategory("Sarees").slice(0, 6);
const occasionEdit = [
  ...getCatalogueByCategory("Occasion Wear"),
  ...getCatalogueByCategory("Wedding Wear"),
].slice(0, 6);
const menEdit = getCatalogueByGroup("Men").slice(0, 6);
---

<BaseLayout
  title="Shri Varasiddhi Shopping Mall | Fashion in Adilabad"
  description="Explore sarees, women's fashion, men's fashion and occasion wear from Shri Varasiddhi Shopping Mall in Adilabad, Telangana."
>
  <SplashScreen />
  <Header />
  <main id="main-content">
    <!-- ─── Story Bubbles ─── -->
    <StoryBubbles />

    <!-- ─── Hero Editorial Banner ─── -->
    <section class="hero" data-carousel aria-roledescription="carousel" aria-label="Featured campaigns">
      <div class="hero__track" data-carousel-track>
        {heroSlides.map((slide, i) => (
          <article class="hero__slide" data-carousel-item aria-roledescription="slide" aria-label={`${i + 1} of ${heroSlides.length}: ${slide.title}`}>
            <span class="hero__bg asset-frame asset-frame--fashion-crop" style={`--crop-x: ${slide.item.crop.x}%; --crop-y: ${slide.item.crop.y}%; --crop-scale: ${slide.item.crop.scale};`}>
              <Image
                class="asset-frame__image"
                src={slide.item.image}
                alt=""
                widths={[720, 1080, 1440, 1920]}
                sizes="100vw"
                quality={80}
                loading={i === 0 ? "eager" : "lazy"}
                fetchpriority={i === 0 ? "high" : undefined}
              />
            </span>
            <div class="hero__content container">
              <p class="hero__eyebrow"><span>Campaign {String(i + 1).padStart(2, "0")}</span> {slide.eyebrow}</p>
              <h2 class="hero__title font-serif">{slide.title}</h2>
              <p class="hero__description">A considered edit for the moments that stay with you.</p>
              <a class="hero__cta" href={slide.href}>{slide.cta}<span aria-hidden="true">↗</span></a>
            </div>
            <p class="hero__caption">{slide.item.alt}</p>
          </article>
        ))}
      </div>
      <div class="hero__controls">
        <div class="hero__controls-main">
          <button type="button" data-carousel-prev aria-label="Previous campaign">←</button>
          <span data-carousel-counter class="hero__counter" aria-live="polite">01 — 03</span>
          <button type="button" data-carousel-next aria-label="Next campaign">→</button>
        </div>
        <div class="hero__progress" role="tablist" aria-label="Choose campaign">
          {heroSlides.map((slide, i) => (
            <button type="button" data-carousel-dot={i} role="tab" aria-label={`Show ${slide.title}`} aria-selected={i === 0}>
              <span>{String(i + 1).padStart(2, "0")}</span>
            </button>
          ))}
        </div>
        <button type="button" class="hero__pause" data-carousel-pause aria-label="Pause campaign autoplay">Pause</button>
      </div>
    </section>

    <!-- ─── Saree Edit ─── -->
    <ProductRail
      title="The Saree Edit"
      items={sareeEdit}
      viewAllHref="/sarees"
    />

    <!-- ─── Promo Strip ─── -->
    <section class="promo-strip" aria-label="Store promotion">
      <div class="promo-strip__inner container">
        <p class="promo-strip__title">Visit us in Adilabad</p>
        <p class="promo-strip__text">See the full collection in person. Our team will help you find the right piece for every occasion.</p>
        <a class="button-primary promo-strip__cta" href="/visit">Plan your visit</a>
      </div>
    </section>

    <!-- ─── Occasion & Festive ─── -->
    <ProductRail
      title="Occasion & Festive"
      items={occasionEdit}
      viewAllHref="/occasion"
    />

    <!-- ─── Men's Edit ─── -->
    <ProductRail
      title="The Men's Edit"
      items={menEdit}
      viewAllHref="/men"
    />

    <VisitCta />
  </main>
  <Footer />
</BaseLayout>

<style>
  /* ─── Category Circles ─── */
  .circle-nav {
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--color-line);
    background: var(--color-paper);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .circle-nav__inner {
    display: flex;
    gap: clamp(1.2rem, 3vw, 2.5rem);
    justify-content: center;
  }

  .circle-nav__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
  }

  .circle-nav__circle {
    display: grid;
    place-items: center;
    width: clamp(3.5rem, 8vw, 5rem);
    height: clamp(3.5rem, 8vw, 5rem);
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: var(--color-stone);
    transition: border-color var(--duration-fast) var(--ease-out), transform var(--duration-hover) var(--ease-out);
  }

  .circle-nav__link:hover .circle-nav__circle {
    border-color: var(--color-gold);
    border-width: 2px;
    transform: scale(1.05);
  }

  .circle-nav__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .circle-nav__label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* ─── Hero Editorial Banner ─── */
  .hero {
    position: relative;
    background: var(--color-title);
    color: var(--color-background);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__track {
    display: flex;
    scroll-snap-type: x mandatory;
  }

  .hero__slide {
    position: relative;
    flex: 0 0 100%;
    scroll-snap-align: start;
    min-height: clamp(34rem, 70svh, 48rem);
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    --asset-ratio: 3 / 4;
  }

  .hero__bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-title) 12%, transparent) 0%,
      color-mix(in srgb, var(--color-title) 15%, transparent) 38%,
      color-mix(in srgb, var(--color-title) 82%, transparent) 100%
    );
  }

  .hero__content {
    position: absolute;
    bottom: clamp(2.5rem, 8vw, 6rem);
    left: var(--gutter);
    right: var(--gutter);
    z-index: 2;
    max-width: 52rem;
    padding-bottom: 2rem;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-background);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .hero__eyebrow span {
    color: var(--color-gold);
  }

  .hero__title {
    font-family: var(--font-display);
    max-width: 9ch;
    font-size: clamp(3rem, 7vw, 6.8rem);
    font-weight: 450;
    letter-spacing: -0.045em;
    line-height: 0.92;
    margin-bottom: 1.25rem;
  }

  .hero__description {
    max-width: 29ch;
    margin-bottom: 1.5rem;
    color: color-mix(in srgb, var(--color-background) 76%, transparent);
    font-size: clamp(0.82rem, 1.2vw, 0.98rem);
    line-height: 1.55;
  }

  .hero__cta {
    display: inline-flex;
    min-height: 2.75rem;
    padding: 0.8rem 1rem 0.8rem 1.1rem;
    background: var(--color-background);
    color: var(--color-title);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    gap: 1.5rem;
    border: 1px solid var(--color-background);
    transition:
      background-color 180ms var(--ease-out),
      color 180ms var(--ease-out),
      border-color 180ms var(--ease-out),
      transform 300ms var(--ease-out);
  }

  .hero__cta span {
    font-size: 1rem;
    transition: transform 240ms var(--ease-out);
  }

  .hero__cta:hover {
    background: var(--color-gold);
    border-color: var(--color-gold);
    color: var(--color-title);
    transform: translateY(-1px);
  }

  .hero__cta:hover span,
  .hero__cta:focus-visible span {
    transform: translate(0.2rem, -0.2rem);
  }

  .hero__caption {
    position: absolute;
    top: 1.25rem;
    right: var(--gutter);
    max-width: 15rem;
    color: color-mix(in srgb, var(--color-background) 62%, transparent);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    line-height: 1.35;
    text-align: right;
    text-transform: uppercase;
  }

  .hero__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 0.7rem var(--gutter);
    background: var(--color-title);
    color: var(--color-background);
  }

  .hero__controls-main,
  .hero__progress {
    display: flex;
    align-items: center;
  }

  .hero__controls-main {
    gap: 0.7rem;
  }

  .hero__controls button {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid color-mix(in srgb, var(--color-background) 22%, transparent);
    border-radius: 50%;
    background: transparent;
    color: inherit;
    font-size: 1rem;
    cursor: pointer;
    transition: border-color 180ms var(--ease-out), color 180ms var(--ease-out);
  }

  .hero__controls button:hover {
    border-color: var(--color-gold);
    color: var(--color-gold);
  }

  .hero__counter {
    min-width: 3.5rem;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted-gold);
  }

  .hero__progress {
    flex: 1;
    gap: 0.35rem;
    max-width: 20rem;
  }

  .hero__progress button {
    position: relative;
    flex: 1;
    height: 1.6rem;
    border: 0;
    background: transparent;
    color: color-mix(in srgb, var(--color-background) 38%, transparent);
    cursor: pointer;
    font-size: 0.58rem;
    text-align: left;
  }

  .hero__progress button::before {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 1px;
    background: currentColor;
    content: "";
  }

  .hero__progress button[aria-selected="true"] {
    color: var(--color-gold);
  }

  .hero__progress button span {
    position: absolute;
    top: 0.45rem;
  }

  .hero__pause {
    border: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-background) 35%, transparent);
    background: transparent;
    color: color-mix(in srgb, var(--color-background) 70%, transparent);
    cursor: pointer;
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    padding: 0.2rem 0 0.3rem;
    text-transform: uppercase;
  }

  .hero__pause:hover {
    color: var(--color-gold);
  }

  /* ─── Promo Strip ─── */
  .promo-strip {
    padding-block: clamp(3rem, 6vw, 5rem);
    background: var(--color-stone);
    color: var(--color-ink);
    text-align: center;
  }

  .promo-strip__inner {
    display: grid;
    gap: 1rem;
    justify-items: center;
  }

  .promo-strip__title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.5vw, 3rem);
    font-weight: 460;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .promo-strip__text {
    max-width: 32rem;
    color: color-mix(in srgb, currentColor 65%, transparent);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .promo-strip__cta {
    margin-top: 0.5rem;
  }

  @media (max-width: 47.99rem) {
    .hero__slide {
      min-height: clamp(31rem, 78svh, 43rem);
    }

    .hero__content {
      bottom: 1rem;
      padding-bottom: 1.25rem;
    }

    .hero__title {
      max-width: 7ch;
      font-size: clamp(3rem, 15vw, 4.7rem);
    }

    .hero__description {
      max-width: 24ch;
      margin-bottom: 1.15rem;
      font-size: 0.78rem;
    }

    .hero__caption {
      top: 1rem;
      right: var(--gutter);
      max-width: 9rem;
      font-size: 0.52rem;
    }

    .hero__controls {
      flex-wrap: wrap;
      padding-block: 0.7rem 0.8rem;
    }

    .hero__progress {
      order: 3;
      flex-basis: 100%;
      max-width: none;
    }

    .hero__pause {
      margin-left: auto;
    }
  }
</style>
