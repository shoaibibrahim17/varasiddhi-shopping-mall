---
import { Image } from "astro:assets";
import { ArrowDownRight } from "lucide-astro";

import type { CatalogueItem } from "../../data/catalogue";

interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  copy?: string;
  items: CatalogueItem[];
  leadIndex?: number;
  tone?: "paper" | "ivory" | "espresso";
  layout?: "feature" | "mosaic" | "rail";
  cta?: { label: string; href: string };
}

const {
  id,
  eyebrow,
  title,
  copy,
  items,
  leadIndex = 0,
  tone = "paper",
  layout = "feature",
  cta,
} = Astro.props;

const lead = items[leadIndex] ?? items[0];
const support = items.filter((_, index) => index !== leadIndex);
const cropStyle = (item: CatalogueItem) => `--crop-x: ${item.crop.x}%; --crop-y: ${item.crop.y}%; --crop-scale: ${item.crop.scale};`;
---

<section class:list={["catalogue-look", `catalogue-look--${tone}`, `catalogue-look--${layout}`]} id={id} data-reveal-section>
  <div class="catalogue-look__inner container">
    <header class="catalogue-look__header">
      <p class="folio-label" data-reveal="eyebrow">{eyebrow}</p>
      <div>
        <h2 class="section-title" data-reveal="title">{title}</h2>
        {copy && <p class="section-copy" data-reveal="copy">{copy}</p>}
        {cta && (
          <a class:list={[tone === "espresso" ? "button-light" : "text-link"]} href={cta.href} data-reveal="copy">
            {cta.label}
            <ArrowDownRight size={16} stroke-width={1.5} aria-hidden="true" />
          </a>
        )}
      </div>
    </header>

    <div class="catalogue-look__grid no-scrollbar" data-lenis-prevent>
      <article class="look-card look-card--lead" data-stagger-item>
        <span class="asset-frame asset-frame--fashion-crop look-card__image" data-image-reveal data-parallax style={cropStyle(lead)}>
          <Image
            class="asset-frame__image"
            src={lead.image}
            alt={lead.alt}
            widths={[520, 760, 1040]}
            sizes="(max-width: 768px) 72vw, 38vw"
            quality={84}
            loading="lazy"
          />
        </span>
        <div>
          <p>{lead.category}</p>
          <h3>{lead.title}</h3>
        </div>
      </article>

      {support.map((item) => (
        <article class="look-card" data-stagger-item>
          <span class="asset-frame asset-frame--fashion-crop look-card__image" style={cropStyle(item)}>
            <Image
              class="asset-frame__image"
              src={item.image}
              alt={item.alt}
              widths={[280, 420, 620]}
              sizes="(max-width: 768px) 58vw, 18vw"
              quality={82}
              loading="lazy"
            />
          </span>
          <div>
            <p>{item.category}</p>
            <h3>{item.title}</h3>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .catalogue-look {
    padding-block: var(--section-space);
    border-top: 1px solid var(--color-line);
  }

  .catalogue-look--paper {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .catalogue-look--ivory {
    background: var(--color-ivory);
    color: var(--color-ink);
  }

  .catalogue-look--espresso {
    background: var(--color-espresso);
    color: var(--color-paper);
  }

  .catalogue-look--espresso .section-copy {
    color: color-mix(in srgb, var(--color-paper) 74%, transparent);
  }

  .catalogue-look__inner {
    display: grid;
    gap: clamp(2.25rem, 5vw, 4.5rem);
  }

  .catalogue-look__header {
    display: grid;
    align-items: end;
    gap: clamp(1.5rem, 4vw, 4rem);
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
  }

  .catalogue-look__header .section-copy {
    margin-top: 1.2rem;
    max-width: 44rem;
  }

  .catalogue-look__header .text-link,
  .catalogue-look__header .button-light {
    margin-top: 1.6rem;
  }

  .catalogue-look__grid {
    display: grid;
    gap: 1px;
    background: color-mix(in srgb, currentColor 18%, transparent);
    grid-template-columns: minmax(0, 1.16fr) repeat(2, minmax(0, 0.72fr));
  }

  .catalogue-look--mosaic .catalogue-look__grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .catalogue-look--rail .catalogue-look__grid {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .look-card {
    scroll-snap-align: start;
    display: grid;
    min-width: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    grid-template-rows: auto auto;
  }

  .catalogue-look--espresso .look-card {
    background: var(--color-espresso);
    color: var(--color-paper);
  }

  .look-card--lead {
    grid-row: span 2;
  }

  .catalogue-look--mosaic .look-card--lead {
    grid-column: span 2;
    grid-row: span 2;
  }

  .catalogue-look--rail .look-card--lead {
    grid-row: auto;
  }

  .look-card__image {
    --asset-ratio: 3 / 4;
  }

  .look-card--lead .look-card__image {
    --asset-ratio: 4 / 5;
  }

  .catalogue-look--rail .look-card__image,
  .catalogue-look--rail .look-card--lead .look-card__image {
    --asset-ratio: 4 / 5;
  }

  .look-card > div {
    min-height: 6.25rem;
    padding: 1rem 1.1rem 1.15rem;
  }

  .look-card p {
    color: var(--color-muted-gold);
    font-size: 0.7rem;
    font-weight: 720;
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .look-card h3 {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-size: clamp(1.18rem, 1.7vw, 1.65rem);
    font-weight: 460;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  @media (max-width: 64rem) {
    .catalogue-look__header,
    .catalogue-look__grid,
    .catalogue-look--mosaic .catalogue-look__grid,
    .catalogue-look--rail .catalogue-look__grid {
      grid-template-columns: 1fr 1fr;
    }

    .look-card--lead,
    .catalogue-look--mosaic .look-card--lead {
      grid-column: 1 / -1;
      grid-row: auto;
    }
  }

  @media (max-width: 47.99rem) {
    .catalogue-look__header {
      grid-template-columns: 1fr;
    }

    .catalogue-look__grid,
    .catalogue-look--mosaic .catalogue-look__grid,
    .catalogue-look--rail .catalogue-look__grid {
      width: auto;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-inline: var(--gutter);
      background: transparent;
      grid-template-columns: minmax(16rem, 72vw) repeat(6, minmax(13.5rem, 58vw));
    }

    .look-card {
      border: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    }

    .look-card--lead .look-card__image,
    .look-card__image {
      --asset-ratio: 4 / 5;
    }

    .look-card > div {
      min-height: 5.75rem;
    }

    .look-card p {
      font-size: 0.75rem;
    }
  }
</style>