---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a href="/" aria-label="Shri Varasiddhi Shopping Mall home">Shri Varasiddhi Shopping Mall</a>
      <p>Adilabad, Telangana</p>
    </div>

    <div class="footer-links" aria-label="Social media links">
      <span class="footer-label">Follow</span>
      <div class="social-links">
        <a href="https://www.instagram.com/varasiddhishoppingmall/" target="_blank" rel="noopener">Instagram</a>
        <a href="https://www.facebook.com/ShriVaraSiddhiShoppingMall/" target="_blank" rel="noopener">Facebook</a>
      </div>
    </div>

    <small>© {year} Shri Varasiddhi Shopping Mall.</small>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-line);
    background: linear-gradient(180deg, var(--color-espresso) 0%, #261910 100%);
    color: var(--color-paper);
  }

  .footer-inner {
    display: grid;
    width: min(100%, var(--content-max));
    min-height: 9rem;
    align-items: center;
    gap: 1rem;
    margin-inline: auto;
    padding: 2rem var(--gutter);
    grid-template-columns: minmax(0, 1.4fr) auto auto;
  }

  .footer-brand {
    display: grid;
    gap: 0.5rem;
  }

  .footer-brand a {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    font-weight: 460;
    letter-spacing: -0.02em;
    line-height: 1;
    text-decoration: none;
  }

  .footer-links {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }

  .footer-label,
  .footer-brand p,
  .footer-inner small {
    color: color-mix(in srgb, var(--color-paper) 72%, transparent);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.25rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid color-mix(in srgb, var(--color-gold) 40%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-gold) 12%, transparent);
    color: var(--color-paper);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
    transition: transform 180ms var(--ease-out), border-color 180ms var(--ease-out), background 180ms var(--ease-out);
  }

  .social-links a:hover,
  .social-links a:focus-visible {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--color-gold) 75%, transparent);
    background: color-mix(in srgb, var(--color-gold) 20%, transparent);
  }

  @media (max-width: 47.99rem) {
    .footer-inner {
      align-items: start;
      grid-template-columns: 1fr;
    }

    .footer-links {
      justify-items: start;
    }

    .footer-brand p,
    .footer-label,
    .footer-inner small {
      font-size: 0.75rem;
    }
  }
</style>
