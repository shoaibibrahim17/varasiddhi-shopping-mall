---
import { Image } from "astro:assets";

import type { CatalogueItem } from "../../data/catalogue";

interface Props {
  item: CatalogueItem;
  eager?: boolean;
}

const { item, eager = false } = Astro.props;

const cropStyle = `--crop-x: ${item.crop.x}%; --crop-y: ${item.crop.y}%; --crop-scale: ${item.crop.scale};`;
---

<article class="product-card" data-stagger-item>
  <a class="product-card__link" href={`/products/${item.id}`} aria-label={`${item.title}, view details`}>
    <span class="product-card__frame asset-frame asset-frame--fashion-crop" style={cropStyle}>
      <Image
        class="asset-frame__image"
        src={item.image}
        alt={item.alt}
        widths={[260, 360, 520, 680]}
        sizes="(max-width: 768px) 45vw, 18vw"
        quality={82}
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : undefined}
      />
    </span>
  </a>
  <div class="product-card__info">
    <p class="product-card__cat">{item.category}</p>
    <h3 class="product-card__name"><a href={`/products/${item.id}`}>{item.title}</a></h3>
    <p class="product-card__price">Price on WhatsApp</p>
    <button type="button" class="product-card__add" data-cart-add={item.id}>
      Add to enquiry
    </button>
  </div>
</article>

<style>
  .product-card {
    display: grid;
    min-width: 0;
    background: var(--color-paper);
  }

  .product-card__link {
    display: block;
    overflow: hidden;
    background: var(--color-stone);
    text-decoration: none;
  }

  .product-card__frame {
    --asset-ratio: 4 / 5;
    transition: opacity 280ms var(--ease-out);
  }

  .product-card__link:hover .product-card__frame::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--color-espresso);
    opacity: 0.08;
  }

  .product-card__frame :global(img) {
    transition: transform 600ms var(--ease-out);
  }

  .product-card__link:hover .product-card__frame :global(img) {
    transform: translateY(var(--parallax-y, 0px)) scale(calc(var(--asset-scale, 1.4) * 1.035));
  }

  .product-card__info {
    display: grid;
    gap: 0.24rem;
    padding: 0.72rem 0 0;
  }

  .product-card__cat {
    color: var(--color-muted-gold);
    font-size: 0.59rem;
    font-weight: 740;
    letter-spacing: 0.1em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .product-card__name {
    font-family: var(--font-display);
    font-size: clamp(0.98rem, 1.1vw, 1.16rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.12;
  }

  .product-card__name a {
    text-decoration: none;
  }

  .product-card__name a:hover,
  .product-card__name a:focus-visible {
    text-decoration: underline;
    text-decoration-color: var(--color-muted-gold);
    text-underline-offset: 0.16em;
  }

  .product-card__price {
    color: color-mix(in srgb, currentColor 62%, transparent);
    font-size: 0.76rem;
    line-height: 1.3;
  }

  .product-card__add {
    display: inline-flex;
    min-height: 2.45rem;
    width: 100%;
    align-items: center;
    justify-content: center;
    margin-top: 0.34rem;
    border: 1px solid var(--color-line);
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
    font-size: 0.64rem;
    font-weight: 760;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
    transition:
      background-color 180ms var(--ease-out),
      border-color 180ms var(--ease-out),
      color 180ms var(--ease-out);
  }

  .product-card__add:hover,
  .product-card__add:focus-visible {
    border-color: var(--color-espresso);
    background: var(--color-espresso);
    color: var(--color-paper);
  }

  .product-card__add:disabled {
    cursor: default;
    opacity: 0.72;
  }
</style>
