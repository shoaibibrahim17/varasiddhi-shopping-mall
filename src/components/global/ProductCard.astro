---
import { Image } from "astro:assets";

import type { CatalogueItem } from "../../data/catalogue";

interface Props {
  item: CatalogueItem;
  eager?: boolean;
}

const { item, eager = false } = Astro.props;

const cropStyle = `--crop-x: ${item.crop.x}%; --crop-y: ${item.crop.y}%; --crop-scale: ${item.crop.scale};`;
---

<article class="product-card" data-stagger-item>
  <a class="product-card__link" href={`/products/${item.id}`} aria-label={`${item.title}, view details`}>
    <span class="product-card__frame asset-frame asset-frame--fashion-crop" style={cropStyle}>
      <Image
        class="asset-frame__image"
        src={item.image}
        alt={item.alt}
        widths={[260, 360, 520, 680]}
        sizes="(max-width: 768px) 45vw, 18vw"
        quality={82}
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : undefined}
      />
    </span>
  </a>
  <div class="product-card__info">
    <span class="product-card__meta">Pure Kanjeevaram Silk</span>
    <p class="product-card__cat">{item.category}</p>
    <h3 class="product-card__name"><a href={`/products/${item.id}`}>{item.title}</a></h3>
    <span class="product-card__index">Look 04</span>
    <p class="product-card__price">Price on WhatsApp</p>
    <button type="button" class="product-card__add" data-cart-add={item.id}>
      Add to enquiry
    </button>
  </div>
</article>

<style>
  .product-card {
    display: grid;
    min-width: 0;
    background: var(--color-paper);
    border: 1px solid rgba(23, 21, 18, 0.08);
  }

  .product-card__link {
    display: block;
    overflow: hidden;
    background: var(--color-stone);
    text-decoration: none;
    border-bottom: 1px solid rgba(23, 21, 18, 0.08);
  }

  .product-card__frame {
    --asset-ratio: 4 / 5;
    transition: opacity 280ms var(--ease-out);
  }

  .product-card__link:hover .product-card__frame::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--color-espresso);
    opacity: 0.08;
  }

  .product-card__frame :global(img) {
    transition: transform 600ms var(--ease-out);
  }

  .product-card__link:hover .product-card__frame :global(img) {
    transform: translateY(var(--parallax-y, 0px)) scale(calc(var(--asset-scale, 1.4) * 1.035));
  }

  .product-card__info {
    display: grid;
    gap: 0.22rem;
    padding: 0.84rem 0.9rem 0.9rem;
  }

  .product-card__meta,
  .product-card__index,
  .product-card__cat {
    color: #7A675F;
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .product-card__index {
    color: #9F8F7D;
    font-size: 0.55rem;
    letter-spacing: 0.16em;
    margin-top: 0.12rem;
  }

  .product-card__name {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.35;
    text-transform: none;
  }

  .product-card__name a {
    color: var(--color-title);
    text-decoration: none;
  }

  .product-card__name a:hover,
  .product-card__name a:focus-visible {
    text-decoration: underline;
    text-decoration-color: var(--color-muted-gold);
    text-underline-offset: 0.16em;
  }

  .product-card__price {
    color: #5A4E49;
    font-family: var(--font-serif);
    font-size: 0.86rem;
    font-style: italic;
    line-height: 1.3;
  }

  .product-card__add {
    display: inline-flex;
    min-height: 2.75rem;
    width: 100%;
    align-items: center;
    justify-content: center;
    margin-top: 0.42rem;
    border: 1px solid #171512;
    background: transparent;
    color: #171512;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.64rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    line-height: 1;
    text-transform: uppercase;
    border-radius: 0;
    transition: background-color 180ms var(--ease-out), color 180ms var(--ease-out);
  }

  .product-card__add:hover,
  .product-card__add:focus-visible {
    border-color: #171512;
    background: #171512;
    color: #F5EFEB;
  }

  .product-card__add:disabled {
    cursor: default;
    opacity: 0.72;
  }
</style>
