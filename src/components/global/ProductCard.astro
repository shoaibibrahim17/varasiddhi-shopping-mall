---
import { Image } from "astro:assets";

import type { CatalogueItem } from "../../data/catalogue";

interface Props {
  item: CatalogueItem;
  eager?: boolean;
}

const { item, eager = false } = Astro.props;

const cropStyle = `--crop-x: ${item.crop.x}%; --crop-y: ${item.crop.y}%; --crop-scale: ${item.crop.scale};`;
---

<article class="product-card" data-stagger-item>
  <a class="product-card__link" href={`/products/${item.id}`} aria-label={`${item.title}, view details`}>
    <span class="product-card__frame asset-frame asset-frame--fashion-crop" style={cropStyle}>
      <Image
        class="asset-frame__image"
        src={item.image}
        alt={item.alt}
        widths={[260, 360, 520, 680]}
        sizes="(max-width: 768px) 45vw, 18vw"
        quality={82}
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : undefined}
      />
    </span>
  </a>
  <div class="product-card__info">
    <div class="product-card__meta-group">
      <span class="product-card__meta">{item.material}</span>
      <p class="product-card__cat">{item.category}</p>
    </div>
    <h3 class="product-card__name"><a href={`/products/${item.id}`}>{item.title}</a></h3>
    <div class="product-card__tag-row">
      <span class="product-card__index">{item.tag}</span>
      <div class="product-card__tag">
        <span class="product-card__tag-text">{item.tag}</span>
      </div>
    </div>
  </div>
</article>

<style>
  .product-card {
    display: block;
    min-width: 0;
    background: var(--color-paper);
    border: 1px solid rgba(23, 21, 18, 0.08);
  }

  .product-card__link {
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--color-stone);
    text-decoration: none;
    border-bottom: 1px solid rgba(23, 21, 18, 0.08);
  }

  .product-card__frame {
    --asset-ratio: 4 / 5;
    transition: opacity 280ms var(--ease-out);
  }

  .product-card__link:hover .product-card__frame::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--color-ink);
    opacity: 0.08;
  }

  .product-card__frame :global(img) {
    transition: transform 600ms var(--ease-out);
  }

  .product-card__link:hover .product-card__frame :global(img) {
    transform: translateY(var(--parallax-y, 0px)) scale(calc(var(--asset-scale, 1.4) * 1.035));
  }

  .product-card__info {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: 0.35rem;
    height: 8.7rem;
    min-height: 0;
    padding: 0.7rem 0.8rem 0.8rem;
  }

  .product-card__meta-group {
    display: grid;
    gap: 0.1rem;
  }

  .product-card__meta,
  .product-card__cat {
    color: var(--color-description);
    font-family: var(--font-sans);
    font-size: 0.58rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .product-card__name {
    font-family: var(--font-sans) !important;
    font-size: 0.88rem;
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.28;
    text-transform: none;
    display: block;
    height: 2.56rem;
    min-height: 2.56rem;
    overflow: hidden;
  }

  .product-card__name a {
    color: var(--color-title);
    text-decoration: none;
  }

  .product-card__name a:hover,
  .product-card__name a:focus-visible {
    text-decoration: underline;
    text-decoration-color: var(--color-muted-gold);
    text-underline-offset: 0.14em;
  }

  .product-card__tag-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .product-card__index {
    color: var(--color-muted-gold);
    font-size: 0.52rem;
    letter-spacing: 0.14em;
    white-space: nowrap;
  }

  .product-card__tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.22rem 0.6rem;
    background: rgba(167, 122, 70, 0.08);
    color: var(--color-muted-gold);
    font-family: var(--font-sans);
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
    border-radius: 0;
    border: 1px solid rgba(167, 122, 70, 0.18);
    white-space: nowrap;
  }

  .product-card__tag-text {
    display: block;
    text-align: center;
    width: 100%;
  }

  @media (max-width: 47.99rem) {
    .product-card__link {
      aspect-ratio: 3 / 4;
    }

    .product-card__frame {
      --asset-ratio: 3 / 4;
    }

    .product-card__info {
      gap: 0.25rem;
      height: 6rem;
      min-height: 0;
      padding: 0.55rem 0.65rem 0.65rem;
    }

    .product-card__meta-group {
      gap: 0.05rem;
    }

    .product-card__meta,
    .product-card__cat {
      font-size: 0.52rem;
      letter-spacing: 0.1em;
      line-height: 1.2;
    }

    .product-card__name {
      font-size: 0.8rem;
      line-height: 1.25;
      height: 2rem;
      min-height: 2rem;
    }

    .product-card__index {
      font-size: 0.48rem;
      letter-spacing: 0.12em;
    }

    .product-card__tag {
      padding: 0.18rem 0.5rem;
      font-size: 0.5rem;
      letter-spacing: 0.1em;
    }

    .product-card__tag-row {
      gap: 0.35rem;
    }
  }

  @media (max-width: 20rem) {
    .product-card__info {
      height: 6.8rem;
    }

    .product-card__name {
      font-size: 0.72rem;
      line-height: 1.2;
      height: 2.6rem;
      min-height: 2.6rem;
    }
  }
</style>
