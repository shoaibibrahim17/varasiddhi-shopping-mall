---
import { site } from "../../data/site";
---

<div data-cart-overlay class="cart-overlay" hidden></div>
<aside data-cart-drawer class="cart-drawer" hidden role="dialog" aria-modal="true" aria-label="Shopping cart">
  <header class="cart-drawer__head">
    <h2>Your cart</h2>
    <button type="button" data-cart-close aria-label="Close cart">&times;</button>
  </header>

  <div data-cart-empty class="cart-drawer__empty">
    <p>Your cart is empty.</p>
    <a href="/catalogue" class="button-primary" data-cart-close>Browse the catalogue</a>
  </div>

  <div data-cart-filled class="cart-drawer__filled" hidden>
    <div data-cart-lines class="cart-drawer__lines"></div>

    <div class="cart-drawer__payment">
      <p class="cart-drawer__payment-label">Payment method</p>
      <label class="cart-drawer__radio">
        <input type="radio" name="cart-payment" value="cod" checked />
        <span class="cart-drawer__radio-label">Cash on Delivery</span>
      </label>
      <label class="cart-drawer__radio cart-drawer__radio--disabled">
        <input type="radio" name="cart-payment" value="prepaid" disabled />
        <span class="cart-drawer__radio-label">Prepaid (UPI / Card)</span>
        <span class="cart-drawer__badge">Coming soon</span>
      </label>
    </div>

    <button type="button" data-cart-checkout class="cart-drawer__checkout button-primary">
      Order via WhatsApp
    </button>

    <p class="cart-drawer__note">{site.payments.cod}</p>
  </div>
</aside>

<style>
  .cart-overlay {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: color-mix(in srgb, var(--color-title) 50%, transparent);
    opacity: 0;
    transition: opacity 280ms var(--ease-out);
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
  }

  .cart-overlay.is-open {
    opacity: 1;
  }

  .cart-drawer {
    position: fixed;
    z-index: 100;
    top: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    width: min(100%, 26rem);
    background: var(--color-paper);
    color: var(--color-ink);
    transform: translateX(100%);
    transition: transform 280ms var(--ease-out);
    will-change: transform;
  }

  .cart-drawer.is-open {
    transform: translateX(0);
  }

  .cart-drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem var(--gutter);
    border-bottom: 1px solid var(--color-line);
  }

  .cart-drawer__head h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 460;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .cart-drawer__head button {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    font-size: 1.6rem;
    cursor: pointer;
    transition: background-color 180ms var(--ease-out);
  }

  .cart-drawer__head button:hover {
    background: color-mix(in srgb, var(--color-espresso) 10%, transparent);
  }

  .cart-drawer__empty {
    display: grid;
    gap: 1.5rem;
    align-content: center;
    justify-items: center;
    flex: 1;
    padding: 3rem var(--gutter);
    text-align: center;
  }

  .cart-drawer__empty p {
    color: color-mix(in srgb, currentColor 60%, transparent);
    font-size: 1rem;
  }

  .cart-drawer__filled {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }

  .cart-drawer__lines {
    flex: 1;
    overflow-y: auto;
    padding: var(--gutter);
  }

  .cart-drawer__payment {
    padding: 1rem var(--gutter);
    border-top: 1px solid var(--color-line);
  }

  .cart-drawer__payment-label {
    color: var(--color-muted-gold);
    font-size: 0.68rem;
    font-weight: 720;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 0.6rem;
  }

  .cart-drawer__radio {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .cart-drawer__radio input {
    accent-color: var(--color-espresso);
  }

  .cart-drawer__radio--disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .cart-drawer__badge {
    margin-left: auto;
    color: var(--color-muted-gold);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .cart-drawer__checkout {
    margin: 0.75rem var(--gutter);
    background: var(--color-gold);
    color: var(--color-ink);
    border-color: var(--color-gold);
    width: calc(100% - var(--gutter) * 2);
    justify-self: center;
  }

  .cart-drawer__checkout:hover {
    background: var(--color-espresso);
    color: var(--color-paper);
    border-color: var(--color-espresso);
  }

  .cart-drawer__note {
    padding: 0.5rem var(--gutter) 1rem;
    color: color-mix(in srgb, currentColor 55%, transparent);
    font-size: 0.75rem;
    line-height: 1.5;
    text-align: center;
  }
</style>

<style is:global>
  .cart-line {
    display: grid;
    grid-template-columns: 4rem 1fr auto;
    gap: 0.75rem;
    align-items: start;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  .cart-line:last-child {
    border-bottom: none;
  }

  .cart-line__img {
    width: 4rem;
    height: 5rem;
    object-fit: cover;
    background: var(--color-stone);
  }

  .cart-line__info {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }

  .cart-line__cat {
    color: var(--color-muted-gold);
    font-size: 0.62rem;
    font-weight: 720;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .cart-line__name {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 470;
    line-height: 1.2;
  }

  .cart-line__qty {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.3rem;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .cart-line__qty button {
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    background: transparent;
    color: inherit;
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    transition: border-color 180ms var(--ease-out);
  }

  .cart-line__qty button:hover {
    border-color: var(--color-espresso);
  }

  .cart-line__remove {
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border: none;
    background: transparent;
    color: color-mix(in srgb, currentColor 50%, transparent);
    font-size: 1.1rem;
    cursor: pointer;
    transition: color 180ms var(--ease-out);
  }

  .cart-line__remove:hover {
    color: var(--color-ink);
  }
</style>
