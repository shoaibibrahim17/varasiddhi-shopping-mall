---
import { site } from "../../data/site";
---

<div data-cart-overlay class="cart-overlay" hidden></div>
<aside data-cart-drawer class="cart-drawer" hidden role="dialog" aria-modal="true" aria-label="Enquiry bag">
  <header class="cart-drawer__head">
    <div>
      <p>WhatsApp</p>
      <h2>Enquiry bag</h2>
    </div>
    <button type="button" data-cart-close aria-label="Close enquiry bag">&times;</button>
  </header>

  <div data-cart-empty class="cart-drawer__empty">
    <p>Your enquiry bag is empty.</p>
    <a href="/catalogue" class="button-primary" data-cart-close>Browse catalogue</a>
  </div>

  <div data-cart-filled class="cart-drawer__filled" hidden>
    <div data-cart-lines class="cart-drawer__lines"></div>

    <div class="cart-drawer__payment">
      <p class="cart-drawer__payment-label">Next step</p>
      <label class="cart-drawer__radio">
        <input type="radio" name="cart-payment" value="whatsapp" checked />
        <span class="cart-drawer__radio-label">Confirm availability on WhatsApp</span>
      </label>
      <label class="cart-drawer__radio cart-drawer__radio--disabled">
        <input type="radio" name="cart-payment" value="online" disabled />
        <span class="cart-drawer__radio-label">Online checkout</span>
        <span class="cart-drawer__badge">Planned</span>
      </label>
    </div>

    <button type="button" data-cart-checkout class="cart-drawer__checkout button-primary">
      Send WhatsApp enquiry
    </button>

    <p class="cart-drawer__note">{site.payments.cod}</p>
  </div>
</aside>

<style>
  .cart-overlay {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: color-mix(in srgb, var(--color-title) 50%, transparent);
    opacity: 0;
    transition: opacity 280ms var(--ease-out);
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
  }

  .cart-overlay.is-open {
    opacity: 1;
  }

  .cart-drawer {
    position: fixed;
    z-index: 100;
    top: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    width: min(100%, 25.5rem);
    background: var(--color-paper);
    color: var(--color-ink);
    transform: translateX(100%);
    transition: transform 280ms var(--ease-out);
    will-change: transform;
  }

  .cart-drawer.is-open {
    transform: translateX(0);
  }

  .cart-drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.05rem var(--gutter);
    border-bottom: 1px solid var(--color-line);
  }

  .cart-drawer__head p {
    margin-bottom: 0.28rem;
    color: var(--color-muted-gold);
    font-size: 0.62rem;
    font-weight: 760;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
  }

  .cart-drawer__head h2 {
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 4vw, 2.2rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1;
  }

  .cart-drawer__head button {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: none;
    background: transparent;
    color: inherit;
    font-size: 1.6rem;
    cursor: pointer;
    transition: background-color 180ms var(--ease-out);
  }

  .cart-drawer__head button:hover {
    background: color-mix(in srgb, var(--color-espresso) 9%, transparent);
  }

  .cart-drawer__empty {
    display: grid;
    gap: 1.35rem;
    align-content: center;
    justify-items: center;
    flex: 1;
    padding: 3rem var(--gutter);
    text-align: center;
  }

  .cart-drawer__empty p {
    color: color-mix(in srgb, currentColor 62%, transparent);
    font-size: 1rem;
  }

  .cart-drawer__filled {
    display: flex;
    flex: 1;
    min-height: 0;
    flex-direction: column;
  }

  .cart-drawer__lines {
    flex: 1;
    overflow-y: auto;
    padding: 0.6rem var(--gutter);
  }

  .cart-drawer__payment {
    padding: 1rem var(--gutter);
    border-top: 1px solid var(--color-line);
  }

  .cart-drawer__payment-label {
    margin-bottom: 0.6rem;
    color: var(--color-muted-gold);
    font-size: 0.64rem;
    font-weight: 760;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .cart-drawer__radio {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding-block: 0.35rem;
    font-size: 0.86rem;
    cursor: pointer;
  }

  .cart-drawer__radio input {
    accent-color: var(--color-espresso);
  }

  .cart-drawer__radio--disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .cart-drawer__badge {
    margin-left: auto;
    color: var(--color-muted-gold);
    font-size: 0.6rem;
    font-weight: 760;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .cart-drawer__checkout {
    width: calc(100% - var(--gutter) * 2);
    margin: 0.75rem var(--gutter);
    border-color: var(--color-gold);
    background: var(--color-gold);
    color: var(--color-ink);
    justify-self: center;
  }

  .cart-drawer__checkout:hover {
    border-color: var(--color-espresso);
    background: var(--color-espresso);
    color: var(--color-paper);
  }

  .cart-drawer__note {
    padding: 0.35rem var(--gutter) calc(1rem + env(safe-area-inset-bottom));
    color: color-mix(in srgb, currentColor 58%, transparent);
    font-size: 0.75rem;
    line-height: 1.5;
    text-align: center;
  }
</style>

<style is:global>
  .cart-line {
    display: grid;
    grid-template-columns: 4rem 1fr auto;
    gap: 0.75rem;
    align-items: start;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  .cart-line:last-child {
    border-bottom: none;
  }

  .cart-line__img {
    width: 4rem;
    height: 5rem;
    object-fit: cover;
    background: var(--color-stone);
  }

  .cart-line__info {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }

  .cart-line__cat {
    color: var(--color-muted-gold);
    font-size: 0.6rem;
    font-weight: 760;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .cart-line__name {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.13;
  }

  .cart-line__qty {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.3rem;
    font-size: 0.85rem;
    font-weight: 650;
  }

  .cart-line__qty button {
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    transition: border-color 180ms var(--ease-out);
  }

  .cart-line__qty button:hover,
  .cart-line__qty button:focus-visible {
    border-color: var(--color-espresso);
  }

  .cart-line__remove {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: none;
    background: transparent;
    color: color-mix(in srgb, currentColor 50%, transparent);
    font-size: 1.1rem;
    cursor: pointer;
    transition: color 180ms var(--ease-out);
  }

  .cart-line__remove:hover,
  .cart-line__remove:focus-visible {
    color: var(--color-ink);
  }
</style>
