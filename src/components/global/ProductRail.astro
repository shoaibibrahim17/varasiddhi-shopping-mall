---
import ProductCard from "./ProductCard.astro";
import { ArrowDownRight } from "lucide-astro";

import type { CatalogueItem } from "../../data/catalogue";

interface Props {
  title: string;
  items: CatalogueItem[];
  viewAllHref?: string;
  viewAllLabel?: string;
}

const { title, items, viewAllHref, viewAllLabel = "View all" } = Astro.props;
const headingId = `rail-${title.replace(/\s+/g, "-").toLowerCase()}`;
---

<section class="product-rail" data-carousel data-carousel-manual aria-labelledby={headingId}>
  <div class="product-rail__header container">
    <h2 class="product-rail__title" id={headingId}>{title}</h2>
    <div class="product-rail__controls">
      {viewAllHref && (
        <a class="product-rail__viewall" href={viewAllHref}>
          {viewAllLabel}
          <ArrowDownRight size={14} stroke-width={1.5} aria-hidden="true" />
        </a>
      )}
      <div class="product-rail__arrows">
        <button type="button" data-carousel-prev aria-label={`Previous ${title}`}>&larr;</button>
        <span data-carousel-counter class="product-rail__counter">01 - {String(items.length).padStart(2, "0")}</span>
        <button type="button" data-carousel-next aria-label={`Next ${title}`}>&rarr;</button>
      </div>
    </div>
  </div>

  <div class="product-rail__track no-scrollbar" data-carousel-track data-lenis-prevent>
    {items.map((item, i) => (
      <div class="product-rail__slide" data-carousel-item>
        <ProductCard item={item} eager={i === 0} />
      </div>
    ))}
  </div>
</section>

<style>
  .product-rail {
    padding-block: clamp(2.4rem, 5vw, 4.6rem);
    border-top: 1px solid var(--color-line);
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .product-rail__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(1rem, 2.4vw, 1.8rem);
  }

  .product-rail__title {
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 3vw, 2.65rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1;
  }

  .product-rail__controls {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .product-rail__viewall {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-muted-gold);
    font-size: 0.68rem;
    font-weight: 740;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 180ms var(--ease-out);
  }

  .product-rail__viewall:hover,
  .product-rail__viewall:focus-visible {
    color: var(--color-espresso);
  }

  .product-rail__arrows {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .product-rail__arrows button {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font-size: 1rem;
    transition: border-color 180ms var(--ease-out), background-color 180ms var(--ease-out);
  }

  .product-rail__arrows button:hover,
  .product-rail__arrows button:focus-visible {
    border-color: var(--color-espresso);
    background: color-mix(in srgb, var(--color-espresso) 5%, transparent);
  }

  .product-rail__counter {
    color: var(--color-muted-gold);
    font-size: 0.68rem;
    font-weight: 740;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .product-rail__track {
    display: flex;
    gap: clamp(0.75rem, 1.5vw, 1.2rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-inline: var(--gutter);
    padding-bottom: 0.5rem;
    background: transparent;
  }

  .product-rail__slide {
    flex: 0 0 min(45vw, 13.5rem);
    scroll-snap-align: start;
    background: var(--color-paper);
  }

  @media (max-width: 47.99rem) {
    .product-rail__header {
      align-items: start;
      flex-direction: column;
    }

    .product-rail__arrows {
      display: none;
    }
  }

  @media (min-width: 48rem) {
    .product-rail__slide {
      flex: 0 0 min(23vw, 16rem);
    }
  }

  @media (min-width: 80rem) {
    .product-rail__slide {
      flex-basis: 16.5rem;
    }
  }
</style>
