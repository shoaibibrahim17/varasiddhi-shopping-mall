---
import ProductCard from "./ProductCard.astro";
import { ArrowDownRight } from "lucide-astro";

import type { CatalogueItem } from "../../data/catalogue";

interface Props {
  title: string;
  items: CatalogueItem[];
  viewAllHref?: string;
  viewAllLabel?: string;
  mobileHint?: boolean;
}

const { title, items, viewAllHref, viewAllLabel = "View all", mobileHint = false } = Astro.props;
const headingId = `rail-${title.replace(/\s+/g, "-").toLowerCase()}`;
---

<section class="product-rail" data-carousel data-carousel-manual data-reveal-section aria-labelledby={headingId}>
  <div class="product-rail__header container">
    <h2 class="product-rail__title" id={headingId}>{title}</h2>
    <div class="product-rail__controls">
      {viewAllHref && (
        <a class="product-rail__viewall" href={viewAllHref}>
          {viewAllLabel}
          <ArrowDownRight size={14} stroke-width={1.5} aria-hidden="true" />
        </a>
      )}
      <div class="product-rail__arrows">
        <button type="button" data-carousel-prev aria-label={`Previous ${title}`}>&larr;</button>
        <span data-carousel-counter class="product-rail__counter">01 - {String(items.length).padStart(2, "0")}</span>
        <button type="button" data-carousel-next aria-label={`Next ${title}`}>&rarr;</button>
      </div>
    </div>
    {mobileHint && <span class="product-rail__mobile-hint">Swipe for more</span>}
  </div>

  <div class="product-rail__track no-scrollbar" data-carousel-track data-lenis-prevent>
    {items.map((item, i) => (
      <div class="product-rail__slide" data-carousel-item>
        {i === 0 && (
          <span class="product-rail__featured-badge">
            <span class="visually-hidden">Featured edit</span>
          </span>
        )}
        <ProductCard item={item} eager={i === 0} />
      </div>
    ))}
  </div>
</section>

<style>
  .product-rail {
    padding-block: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--color-line);
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .product-rail__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(1.3rem, 2.8vw, 2rem);
  }

  .product-rail__title {
    font-family: var(--font-heading) !important;
    font-size: clamp(1.65rem, 3vw, 2.65rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.96;
    text-transform: uppercase;
  }

  .product-rail__controls {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .product-rail__mobile-hint {
    display: none;
  }

  .product-rail__viewall {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-muted-gold);
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 180ms var(--ease-out);
  }

  .product-rail__viewall:hover,
  .product-rail__viewall:focus-visible {
    color: var(--color-espresso);
  }

  .product-rail__arrows {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .product-rail__arrows button {
    display: grid;
    place-items: center;
    width: auto;
    height: auto;
    border: 0;
    background: transparent;
    color: var(--color-title);
    cursor: pointer;
    font-size: 1.1rem;
    line-height: 1;
    border-radius: 0;
    transition: color 180ms var(--ease-out);
  }

  .product-rail__arrows button:hover,
  .product-rail__arrows button:focus-visible {
    color: var(--color-maroon);
  }

  .product-rail__counter {
    color: var(--color-description);
    font-family: var(--font-sans);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .product-rail__track {
    display: flex;
    align-items: flex-start;
    gap: clamp(0.75rem, 1.5vw, 1.2rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-inline: var(--gutter);
    padding-top: 1.05rem;
    padding-bottom: 0.5rem;
    background: transparent;
  }

  .product-rail__slide {
    position: relative;
    display: grid;
    align-items: stretch;
    flex: 0 0 min(42vw, 10.5rem);
    min-width: 0;
    scroll-snap-align: start;
    background: var(--color-paper);
  }

  .product-rail__featured-badge {
    position: absolute;
    top: -0.95rem;
    left: 0;
    z-index: 1;
    color: var(--color-muted-gold);
    font-family: var(--font-sans);
    font-size: 0.52rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1;
    text-transform: uppercase;
  }

  .product-rail__slide :global(.product-card) {
    width: 100%;
    height: 100%;
    align-self: stretch;
  }

  @media (max-width: 47.99rem) {
    .product-rail__header {
      align-items: start;
      flex-direction: column;
    }

    .product-rail__arrows {
      display: none;
    }

    .product-rail__mobile-hint {
      display: block;
      margin-top: -0.45rem;
      color: var(--color-description);
      font-size: 0.62rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
  }

  @media (min-width: 48rem) {
    .product-rail__slide {
      flex: 0 0 min(23vw, 16rem);
    }
  }

  @media (min-width: 80rem) {
    .product-rail__slide {
      flex-basis: 16.5rem;
    }
  }
</style>
