---
import { Image } from "astro:assets";
import { Menu, X, Search, ShoppingBag, MessageCircle } from "lucide-astro";

import { site } from "../../data/site";
import logo from "../../assets/brand/logo/varasiddhi-logo-primary.png";

const navigation = [
  { label: "New arrivals", href: "/catalogue" },
  { label: "Sarees", href: "/sarees" },
  { label: "Women", href: "/women" },
  { label: "Men", href: "/men" },
  { label: "Occasion", href: "/occasion" },
  { label: "Visit", href: "/visit" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => currentPath === href;
const whatsappHref = `https://wa.me/${site.whatsappNumber}`;
---

<header class="site-header" role="banner">
  <div class="site-header__inner">
    <button type="button" class="icon-btn site-header__menu" data-menu-open aria-label="Open menu">
      <Menu size={21} stroke-width={1.6} aria-hidden="true" />
    </button>

    <a class="brand" href="/" aria-label="Shri Varasiddhi Shopping Mall home">
      <Image
        class="brand__logo"
        src={logo}
        alt="Shri Varasiddhi Shopping Mall"
        widths={[180, 260, 360]}
        sizes="(max-width: 768px) 132px, 180px"
        loading="eager"
      />
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      {
        navigation.map((item) => (
          <a href={item.href} class:list={[isActive(item.href) && "is-active"]} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
        ))
      }
    </nav>

    <div class="site-header__actions">
      <a class="icon-btn" href="/catalogue" aria-label="Browse catalogue">
        <Search size={20} stroke-width={1.5} aria-hidden="true" />
      </a>
      <a class="icon-btn site-header__whatsapp" href={whatsappHref} target="_blank" rel="noopener" aria-label="Enquire on WhatsApp">
        <MessageCircle size={20} stroke-width={1.5} aria-hidden="true" />
      </a>
      <button type="button" class="icon-btn icon-btn--cart" data-cart-open aria-label="Open enquiry bag">
        <ShoppingBag size={20} stroke-width={1.5} aria-hidden="true" />
        <span class="header-cart__badge" data-cart-count hidden>0</span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-drawer" data-mobile-drawer hidden>
  <div class="mobile-drawer__overlay" data-mobile-overlay></div>
  <aside class="mobile-drawer__panel" data-mobile-panel aria-label="Mobile navigation">
    <div class="mobile-drawer__head">
      <span class="mobile-drawer__title">Menu</span>
      <button type="button" class="icon-btn" data-menu-close aria-label="Close menu">
        <X size={20} stroke-width={1.5} aria-hidden="true" />
      </button>
    </div>
    <nav class="mobile-drawer__nav" aria-label="Mobile">
      {
        navigation.map((item) => (
          <a href={item.href} class:list={[isActive(item.href) && "is-active"]} aria-current={isActive(item.href) ? "page" : undefined} data-mobile-nav-item>{item.label}</a>
        ))
      }
    </nav>
    <div class="mobile-drawer__footer">
      <a class="button-primary" href={whatsappHref} target="_blank" rel="noopener">WhatsApp enquiry</a>
      <span class="mobile-drawer__note">Online orders are planned for a later release.</span>
    </div>
  </aside>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-paper) 94%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr) auto;
    align-items: center;
    width: min(100%, var(--content-max));
    min-height: 4.15rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
    gap: 0.45rem;
  }

  .site-header__menu {
    justify-self: start;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    justify-self: center;
    min-width: 0;
    text-decoration: none;
  }

  .brand__logo {
    width: clamp(8rem, 32vw, 11.25rem);
    height: auto;
    object-fit: contain;
  }

  .desktop-nav {
    display: none;
    align-items: center;
    justify-self: center;
    gap: clamp(1.05rem, 1.6vw, 1.8rem);
  }

  .desktop-nav a {
    position: relative;
    padding-block: 0.7rem;
    color: var(--color-title);
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color 180ms var(--ease-out);
  }

  .desktop-nav a::after {
    position: absolute;
    right: 0;
    bottom: 0.45rem;
    left: 0;
    height: 1px;
    transform: scaleX(0);
    transform-origin: right;
    background: var(--color-maroon);
    content: "";
    transition: transform 260ms var(--ease-out);
  }

  .desktop-nav a:hover::after,
  .desktop-nav a:focus-visible::after,
  .desktop-nav a.is-active::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 0.1rem;
  }

  .icon-btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    background: transparent;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 180ms var(--ease-out), color 180ms var(--ease-out);
  }

  .icon-btn:hover,
  .icon-btn:focus-visible {
    background: color-mix(in srgb, var(--color-espresso) 8%, transparent);
    color: var(--color-maroon);
  }

  .icon-btn--cart {
    position: relative;
  }

  .header-cart__badge {
    position: absolute;
    top: 0.28rem;
    right: 0.2rem;
    display: grid;
    place-items: center;
    min-width: 1.08rem;
    height: 1.08rem;
    padding-inline: 0.28rem;
    border-radius: 999px;
    background: var(--color-maroon);
    color: var(--color-paper);
    font-size: 0.56rem;
    font-weight: 750;
    line-height: 1;
  }

  @media (max-width: 23.5rem) {
    .site-header__whatsapp {
      display: none;
    }
  }

  @media (min-width: 64rem) {
    .site-header__inner {
      grid-template-columns: auto 1fr auto;
      min-height: 5rem;
    }

    .site-header__menu {
      display: none;
    }

    .brand {
      justify-self: start;
    }

    .desktop-nav {
      display: flex;
    }
  }

  .mobile-drawer {
    position: fixed;
    inset: 0;
    z-index: 60;
    visibility: hidden;
  }

  .mobile-drawer[hidden] {
    display: block;
  }

  .mobile-drawer.is-open {
    visibility: visible;
  }

  .mobile-drawer__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: color-mix(in srgb, var(--color-title) 42%, transparent);
    opacity: 0;
    transition: opacity 260ms var(--ease-out);
  }

  .mobile-drawer.is-open .mobile-drawer__overlay {
    opacity: 1;
  }

  .mobile-drawer__panel {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    z-index: 2;
    display: flex;
    width: min(86vw, 22rem);
    flex-direction: column;
    border-right: 1px solid var(--color-line);
    background: var(--color-paper);
    color: var(--color-title);
    transform: translateX(-100%);
    transition: transform 300ms var(--ease-out);
  }

  .mobile-drawer.is-open .mobile-drawer__panel {
    transform: translateX(0);
  }

  .mobile-drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.05rem var(--gutter);
    border-bottom: 1px solid var(--color-line);
  }

  .mobile-drawer__title {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 520;
    line-height: 1;
  }

  .mobile-drawer__nav {
    display: flex;
    flex-direction: column;
    padding-block: 0.35rem;
  }

  .mobile-drawer__nav a {
    display: flex;
    min-height: 3.55rem;
    align-items: center;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-title);
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.05;
    padding-inline: var(--gutter);
    text-decoration: none;
  }

  .mobile-drawer__nav a:hover,
  .mobile-drawer__nav a:focus-visible {
    background: color-mix(in srgb, var(--color-espresso) 5%, transparent);
  }

  .mobile-drawer__nav a.is-active {
    color: var(--color-maroon);
  }

  .mobile-drawer__footer {
    display: grid;
    gap: 0.75rem;
    margin-top: auto;
    padding: 1.25rem var(--gutter) calc(1.25rem + env(safe-area-inset-bottom));
  }

  .mobile-drawer__note {
    color: var(--color-description);
    font-size: 0.74rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-drawer__panel,
    .mobile-drawer__overlay {
      transition-duration: 0.01ms;
    }
  }
</style>
