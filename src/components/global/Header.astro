---
import { Image } from "astro:assets";
import { Menu, X, ShoppingBag } from "lucide-astro";

import logo from "../../assets/brand/logo/varasiddhi-logo-primary.png";

const navigation = [
  { label: "Women", href: "/women" },
  { label: "Sarees", href: "/sarees" },
  { label: "Men", href: "/men" },
  { label: "Occasion", href: "/occasion" },
  { label: "Catalogue", href: "/catalogue" },
  { label: "Visit Us", href: "/visit" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => currentPath === href;
---

<header class="site-header">
  <div class="header-inner">
    <nav class="desktop-nav desktop-nav--left" aria-label="Primary">
      {
        navigation.slice(0, 3).map((item) => (
          <a href={item.href} class:list={[isActive(item.href) && "is-active"]} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
        ))
      }
    </nav>

    <a class="brand" href="/" aria-label="Shri Varasiddhi Shopping Mall home">
      <span class="brand-viewport">
        <Image
          class="brand-image"
          src={logo}
          alt="Shri Varasiddhi Shopping Mall"
          width={256}
          quality={90}
          loading="eager"
        />
      </span>
    </a>

    <nav class="desktop-nav desktop-nav--right" aria-label="Shop">
      {
        navigation.slice(3).map((item) => (
          <a href={item.href} class:list={[isActive(item.href) && "is-active"]} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
        ))
      }
    </nav>

    <button type="button" class="header-cart" data-cart-open aria-label="Open shopping cart">
      <ShoppingBag size={20} stroke-width={1.5} aria-hidden="true" />
      <span class="header-cart__badge" data-cart-count hidden>0</span>
    </button>

    <button type="button" class="header-cart" data-cart-open aria-label="Open shopping cart">
      <ShoppingBag size={20} stroke-width={1.5} aria-hidden="true" />
      <span class="header-cart__badge" data-cart-count hidden>0</span>
    </button>

    <details class="mobile-menu" data-mobile-menu>
      <summary aria-expanded="false" aria-controls="mobile-nav-panel" aria-label="Menu">
        <span aria-hidden="true">Menu</span>
        <Menu class="menu-icon menu-icon--open" size={20} stroke-width={1.5} aria-hidden="true" />
        <X class="menu-icon menu-icon--close" size={20} stroke-width={1.5} aria-hidden="true" />
      </summary>
      <div class="mobile-panel" id="mobile-nav-panel" data-mobile-panel>
        <nav aria-label="Mobile navigation">
          {
            navigation.map((item) => (
              <a href={item.href} class:list={[isActive(item.href) && "is-active"]} aria-current={isActive(item.href) ? "page" : undefined} data-mobile-nav-item>{item.label}</a>
            ))
          }
        </nav>
        <p>Adilabad <span aria-hidden="true">·</span> Telangana</p>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-paper);
  }

  .header-inner {
    position: relative;
    display: grid;
    width: min(100%, var(--content-max));
    min-height: 5.1rem;
    align-items: center;
    margin-inline: auto;
    padding-inline: var(--gutter);
    grid-template-columns: 1fr auto 1fr;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 2.5vw, 2.75rem);
  }

  .desktop-nav--right {
    justify-content: flex-end;
  }

  .desktop-nav a {
    position: relative;
    padding-block: 0.75rem;
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.105em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .desktop-nav a::after {
    position: absolute;
    right: 0;
    bottom: 0.45rem;
    left: 0;
    height: 1px;
    transform: scaleX(0);
    transform-origin: right;
    background: var(--color-muted-gold);
    content: "";
    transition: transform 280ms var(--ease-out);
  }

  .desktop-nav a:hover::after,
  .desktop-nav a:focus-visible::after,
  .desktop-nav a.is-active::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .brand {
    display: grid;
    justify-self: center;
    text-decoration: none;
  }

  .brand-viewport {
    position: relative;
    display: block;
    width: 6.35rem;
    height: 3.7rem;
    overflow: hidden;
  }

  .brand-image {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 7.55rem;
    max-width: none;
    transform: translate(-50%, -50%);
  }

  .mobile-menu {
    display: none;
  }

  .header-cart {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: none;
    background: transparent;
    color: inherit;
    cursor: pointer;
    transition: background-color 180ms var(--ease-out);
  }

  .header-cart:hover {
    background: color-mix(in srgb, var(--color-espresso) 8%, transparent);
  }

  .header-cart__badge {
    position: absolute;
    top: 0.25rem;
    right: 0.15rem;
    display: grid;
    place-items: center;
    min-width: 1.1rem;
    height: 1.1rem;
    padding: 0 0.3rem;
    border-radius: 50%;
    background: var(--color-gold);
    color: var(--color-ink);
    font-size: 0.55rem;
    font-weight: 700;
    line-height: 1;
  }

  @media (max-width: 64rem) {
    .desktop-nav {
      gap: 1.2rem;
    }

    .desktop-nav a {
      font-size: 0.68rem;
    }
  }

  @media (max-width: 47.99rem) {
    .header-inner {
      min-height: 4rem;
      grid-template-columns: 1fr auto auto;
    }

    .desktop-nav {
      display: none;
    }

    .brand {
      justify-self: start;
    }

    .brand-viewport {
      width: 6.45rem;
      height: 3.65rem;
    }

    .brand-image {
      width: 7.9rem;
    }

    .header-cart {
      justify-self: end;
    }

    .mobile-menu {
      display: block;
      justify-self: end;
    }

    .mobile-menu summary {
      display: flex;
      min-width: 4.75rem;
      min-height: 2.75rem;
      cursor: pointer;
      list-style: none;
      align-items: center;
      justify-content: flex-end;
      gap: 0.6rem;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .mobile-menu summary::-webkit-details-marker {
      display: none;
    }

    .menu-icon--close,
    .mobile-menu[open] .menu-icon--open {
      display: none;
    }

    .mobile-menu[open] .menu-icon--close {
      display: block;
    }

    .mobile-panel {
      position: absolute;
      z-index: 30;
      top: 100%;
      right: 0;
      left: 0;
      padding: 1.5rem var(--gutter) 2rem;
      border-top: 1px solid color-mix(in srgb, var(--color-paper) 16%, transparent);
      background: var(--color-espresso);
      color: var(--color-paper);
    }

    .mobile-panel nav {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .mobile-panel a {
      display: flex;
      min-height: 3.65rem;
      align-items: center;
      border-bottom: 1px solid
        color-mix(in srgb, var(--color-paper) 18%, transparent);
      font-family: var(--font-display);
      font-size: 1.55rem;
      line-height: 1;
      text-decoration: none;
    }

    .mobile-panel a.is-active {
      color: var(--color-gold);
    }

    .mobile-panel a:nth-child(even) {
      padding-left: 1rem;
      border-left: 1px solid
        color-mix(in srgb, var(--color-paper) 18%, transparent);
    }
    @media (prefers-reduced-motion: no-preference) {
      .mobile-menu[open] .mobile-panel {
        animation: mobile-panel-enter 260ms var(--ease-out) both;
      }

      .mobile-menu[open] .mobile-panel a {
        animation: mobile-link-enter 320ms var(--ease-out) both;
      }

      .mobile-menu[open] .mobile-panel a:nth-child(2) {
        animation-delay: 35ms;
      }

      .mobile-menu[open] .mobile-panel a:nth-child(3) {
        animation-delay: 70ms;
      }

      .mobile-menu[open] .mobile-panel a:nth-child(4) {
        animation-delay: 105ms;
      }

      .mobile-menu[open] .mobile-panel a:nth-child(5) {
        animation-delay: 140ms;
      }

      .mobile-menu[open] .mobile-panel a:nth-child(6) {
        animation-delay: 175ms;
      }

      @keyframes mobile-panel-enter {
        from {
          opacity: 0;
          transform: translateY(-0.6rem);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes mobile-link-enter {
        from {
          opacity: 0;
          transform: translateY(0.55rem);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
    }

    .mobile-panel p {
      margin-top: 1.5rem;
      color: color-mix(in srgb, var(--color-paper) 66%, transparent);
      font-size: 0.78rem;
      font-weight: 650;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }
  }
</style>






