---
import { Image } from "astro:assets";

import { getCatalogueByGroup, type CatalogueItem } from "../../data/catalogue";

const men = getCatalogueByGroup("Men");

function cropStyle(item: CatalogueItem) {
  return `--crop-x: ${item.crop.x}%; --crop-y: ${item.crop.y}%; --crop-scale: ${item.crop.scale};`;
}
---

<section class="men-edit page-section" id="men" aria-labelledby="men-title">
  <div class="men-heading container">
    <div>
      <p class="folio-label">Men</p>
      <h2 class="section-title" id="men-title">
        Menswear, edited without losing warmth.
      </h2>
    </div>
    <p class="section-copy">
      The men’s chapter balances ethnicwear and casualwear with clean spacing,
      dark textile fields and direct product imagery.
    </p>
  </div>

  <div class="men-grid container no-scrollbar">
    {
      men.map((item, index) => (
        <article class:list={["men-card", index === 0 && "men-card--large"]}>
          <span class="men-image asset-frame asset-frame--fashion-crop" style={cropStyle(item)}>
            <Image
              src={item.image}
              alt={item.alt}
              widths={[360, 520, 760]}
              sizes="(max-width: 768px) 78vw, 28vw"
              quality={82}
              loading={index === 0 ? "eager" : "lazy"}
            />
          </span>
          <div>
            <p>{item.category}</p>
            <h3>{item.title}</h3>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .men-edit {
    background: var(--color-espresso);
    color: var(--color-paper);
  }

  .men-edit .folio-label,
  .men-card p {
    color: var(--color-gold);
  }

  .men-heading {
    display: grid;
    align-items: end;
    gap: clamp(1.5rem, 4vw, 4rem);
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .men-heading .section-copy {
    color: color-mix(in srgb, var(--color-paper) 72%, transparent);
  }

  .men-grid {
    display: grid;
    gap: 1px;
    margin-top: clamp(2.25rem, 5vw, 3.75rem);
    background: color-mix(in srgb, var(--color-paper) 22%, transparent);
    grid-template-columns: 1.05fr 0.95fr 0.95fr;
  }

  .men-card {
    scroll-snap-align: start;
    display: grid;
    min-width: 0;
    background: var(--color-espresso);
    grid-template-rows: auto auto;
  }

  .men-image {
    --asset-scale: 2.02;
    --asset-x: 20%;
    --asset-y: 48%;
    background: #1f160f;
  }

  .men-card--large .men-image {
    --asset-ratio: 3 / 4;
  }

  .men-image img {
    width: 100%;
    height: 100%;
    max-width: none;
    transform: scale(var(--asset-scale));
    transform-origin: left center;
    object-fit: cover;
    object-position: var(--asset-x) var(--asset-y);
  }

  .men-card > div {
    padding: 1rem 1.1rem 1.15rem;
  }

  .men-card p {
    font-size: 0.68rem;
    font-weight: 720;
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .men-card h3 {
    margin-top: 0.35rem;
    color: var(--color-paper);
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.55vw, 1.55rem);
    font-weight: 460;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  @media (max-width: 64rem) {
    .men-heading {
      grid-template-columns: 1fr;
    }

    .men-grid {
      grid-template-columns: 1fr 1fr;
    }

    .men-card--large {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 47.99rem) {
    .men-grid {
      width: auto;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-inline: var(--gutter);
      background: transparent;
      grid-template-columns: repeat(3, minmax(14.5rem, 68vw));
    }

    .men-card,
    .men-card--large {
      border: 1px solid color-mix(in srgb, var(--color-paper) 18%, transparent);
      grid-column: auto;
    }

    .men-card--large .men-image,
    .men-image {
      --asset-ratio: 4 / 5;
    }
  }
</style>

