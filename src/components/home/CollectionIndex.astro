---
import { Image } from "astro:assets";

import { getCatalogueItem, type CatalogueItem } from "../../data/catalogue";

const chapters = [
  {
    eyebrow: "01",
    title: "Women’s edits",
    href: "#women",
    item: getCatalogueItem("royal-blue-anarkali"),
    copy: "Composed occasion, fusion and festive silhouettes for a dressed-up wardrobe.",
  },
  {
    eyebrow: "02",
    title: "Saree room",
    href: "#sarees",
    item: getCatalogueItem("designer-brocade-saree"),
    copy: "Silk, brocade, festive red and cotton saree directions shown as catalogue previews.",
  },
  {
    eyebrow: "03",
    title: "Men’s wear",
    href: "#men",
    item: getCatalogueItem("classic-white-kurta"),
    copy: "Ethnic and casual menswear presented with the same editorial restraint.",
  },
  {
    eyebrow: "04",
    title: "Occasion dressing",
    href: "#occasion",
    item: getCatalogueItem("mustard-sharara-set"),
    copy: "Celebration-led dressing across sarees, women’s occasionwear and men’s ethnic wear.",
  },
];

function cropStyle(item: CatalogueItem) {
  return `--crop-x: ${item.crop.x}%; --crop-y: ${item.crop.y}%; --crop-scale: ${item.crop.scale};`;
}
---

<section class="collection-index page-section" id="collections" aria-labelledby="collections-title">
  <div class="collection-heading container">
    <p class="folio-label">Catalogue chapters</p>
    <div>
      <h2 class="section-title" id="collections-title">
        A considered route through the collection.
      </h2>
      <p class="section-copy">
        Browse the current fashion previews by chapter. The page uses only the
        supplied catalogue artwork and avoids prices, stock claims or invented
        store details.
      </p>
    </div>
  </div>

  <div class="chapter-grid container no-scrollbar" aria-label="Catalogue chapter links">
    {
      chapters.map((chapter) => (
        <a class="chapter-card" href={chapter.href}>
          <figure>
            <span class="chapter-image asset-frame asset-frame--fashion-crop" style={cropStyle(chapter.item)}>
              <Image
                src={chapter.item.image}
                alt={chapter.item.alt}
                widths={[360, 520, 720]}
                sizes="(max-width: 768px) 72vw, 25vw"
                quality={82}
                loading="eager"
              />
            </span>
            <figcaption>
              <span>{chapter.eyebrow}</span>
              <strong>{chapter.title}</strong>
              <p>{chapter.copy}</p>
            </figcaption>
          </figure>
        </a>
      ))
    }
  </div>
</section>

<style>
  .collection-heading {
    display: grid;
    align-items: end;
    gap: clamp(2rem, 5vw, 5rem);
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
  }

  .collection-heading .section-copy {
    margin-top: 1.5rem;
  }

  .chapter-grid {
    display: grid;
    gap: 1px;
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    background: var(--color-line);
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .chapter-card {
    scroll-snap-align: start;
    display: block;
    min-width: 0;
    background: var(--color-paper);
    text-decoration: none;
  }

  .chapter-card figure {
    display: grid;
    height: 100%;
    min-height: 0;
    margin: 0;
    grid-template-rows: minmax(0, 1fr) auto;
  }

  .chapter-image {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-stone);
  }

  .chapter-image img {
    width: 100%;
    height: 100%;
    max-width: none;
    transform: scale(var(--crop-scale));
    transform-origin: left center;
    object-fit: cover;
    object-position: var(--crop-x) var(--crop-y);
    transition: transform 500ms var(--ease-out);
  }

  .chapter-card:hover img,
  .chapter-card:focus-visible img {
    transform: scale(calc(var(--crop-scale) + 0.04));
  }

  .chapter-card figcaption {
    min-height: 9.75rem;
    padding: 1.35rem;
  }

  .chapter-card figcaption span {
    color: var(--color-muted-gold);
    font-size: 0.68rem;
    font-weight: 720;
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .chapter-card figcaption strong {
    display: block;
    margin-top: 0.45rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    font-weight: 460;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .chapter-card figcaption p {
    margin-top: 1rem;
    color: color-mix(in srgb, var(--color-ink) 66%, transparent);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  @media (max-width: 64rem) {
    .collection-heading {
      grid-template-columns: 1fr;
    }

    .chapter-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 47.99rem) {
    .collection-index {
      overflow: hidden;
    }

    .chapter-grid {
      width: auto;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-inline: var(--gutter);
      background: transparent;
      grid-template-columns: repeat(4, minmax(16.5rem, 72vw));
    }

    .chapter-card {
    scroll-snap-align: start;
      border: 1px solid var(--color-line);
    }

    .chapter-card figure {
      min-height: 0;
    }

    .chapter-image {
      aspect-ratio: 4 / 5;
    }
  }
</style>


