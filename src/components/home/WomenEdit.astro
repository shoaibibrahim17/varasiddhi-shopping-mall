---
import { Image } from "astro:assets";
import { ArrowDownRight } from "lucide-astro";

import { getCatalogueItem, type CatalogueItem } from "../../data/catalogue";

const feature = getCatalogueItem("royal-blue-anarkali");
const items = [
  feature,
  getCatalogueItem("mustard-sharara-set"),
  getCatalogueItem("sparkle-pink-coord"),
];

function cropStyle(item: CatalogueItem) {
  return `--crop-x: ${item.crop.x}%; --crop-y: ${item.crop.y}%; --crop-scale: ${item.crop.scale};`;
}
---

<section class="women-edit page-section" id="women" aria-labelledby="women-title">
  <div class="women-layout container">
    <div class="women-copy">
      <p class="folio-label">Women</p>
      <h2 class="section-title" id="women-title">
        Occasion pieces with colour, line and presence.
      </h2>
      <p class="section-copy">
        The women’s chapter keeps garment artwork large and readable: anarkali,
        sharara and fusion looks are treated as a composed lookbook rather than
        a commerce grid.
      </p>
      <a class="text-link" href="#occasion">
        See occasion dressing
        <ArrowDownRight size={16} stroke-width={1.5} aria-hidden="true" />
      </a>
    </div>

    <figure class="women-feature">
      <span class="editorial-image asset-frame asset-frame--fashion-crop" style={cropStyle(feature)}>
        <Image
          src={feature.image}
          alt={feature.alt}
          widths={[520, 760, 1040]}
          sizes="(max-width: 768px) 100vw, 43vw"
          quality={84}
          loading="eager"
        />
      </span>
      <figcaption>
        <span>Featured preview</span>
        <strong>{feature.title}</strong>
      </figcaption>
    </figure>

    <div class="women-rail no-scrollbar" aria-label="Women catalogue previews">
      {
        items.map((item) => (
          <article class="rail-card">
            <span class="rail-image asset-frame asset-frame--fashion-crop" style={cropStyle(item)}>
              <Image
                src={item.image}
                alt={item.alt}
                widths={[280, 420, 560]}
                sizes="(max-width: 768px) 58vw, 19vw"
                quality={82}
                loading="eager"
              />
            </span>
            <p>{item.category}</p>
            <h3>{item.title}</h3>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .women-edit {
    background: var(--color-ivory);
  }

  .women-layout {
    display: grid;
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1fr);
  }

  .women-copy .section-copy {
    margin-top: 1.5rem;
  }

  .women-copy .text-link {
    margin-top: 2rem;
  }

  .women-feature {
    position: relative;
    margin: 0;
  }

  .editorial-image,
  .rail-image {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--color-stone);
  }

  .editorial-image {
    aspect-ratio: 4 / 5;
  }

  .editorial-image img,
  .rail-image img {
    width: 100%;
    height: 100%;
    max-width: none;
    transform: scale(var(--crop-scale));
    transform-origin: left center;
    object-fit: cover;
    object-position: var(--crop-x) var(--crop-y);
  }

  .women-feature figcaption {
    position: absolute;
    right: 0;
    bottom: 0;
    width: min(17rem, 74%);
    padding: 1.1rem 1.25rem;
    background: var(--color-crimson-deep);
    color: var(--color-paper);
  }

  .women-feature figcaption span,
  .rail-card p {
    color: var(--color-gold);
    font-size: 0.65rem;
    font-weight: 720;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .women-feature figcaption strong,
  .rail-card h3 {
    display: block;
    margin-top: 0.3rem;
    font-family: var(--font-display);
    font-size: clamp(1.42rem, 2.2vw, 1.7rem);
    font-weight: 460;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .women-rail {
    display: grid;
    gap: 1rem;
    padding-top: 1.5rem;
    overflow-x: auto;
      scroll-snap-type: x mandatory;
    grid-column: 1 / -1;
    grid-template-columns: repeat(3, minmax(16rem, 1fr));
  }

  .rail-card {
    scroll-snap-align: start;
    display: grid;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
  }

  .rail-image {
    aspect-ratio: 4 / 5;
  }

  .rail-card p {
    color: var(--color-muted-gold);
  }

  .rail-card h3 {
    max-width: 13ch;
  }

  @media (max-width: 47.99rem) {
    .women-layout {
      grid-template-columns: 1fr;
    }

    .editorial-image {
      aspect-ratio: 4 / 5;
    }

    .women-rail {
      width: auto;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      grid-template-columns: repeat(3, minmax(14.5rem, 64vw));
    }
  }
</style>





