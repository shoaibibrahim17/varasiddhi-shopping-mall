---
import { Image } from "astro:assets";
import { ArrowDownRight } from "lucide-astro";

import { getCatalogueItem, type CatalogueItem } from "../../data/catalogue";

type CategoryWindowItem = {
  label: string;
  href: string;
  detail: string;
  item: CatalogueItem;
  support: CatalogueItem[];
};

const categories: CategoryWindowItem[] = [
  {
    label: "Women",
    href: "/women",
    detail: "Occasion, fusion and festive direction",
    item: getCatalogueItem("royal-blue-anarkali"),
    support: [getCatalogueItem("blush-pink-anarkali"), getCatalogueItem("sparkle-pink-coord")],
  },
  {
    label: "Sarees",
    href: "/sarees",
    detail: "Silk, brocade, cotton and festive sarees",
    item: getCatalogueItem("designer-brocade-saree"),
    support: [getCatalogueItem("maroon-silk-saree"), getCatalogueItem("kalamkari-cotton-saree")],
  },
  {
    label: "Men",
    href: "/men",
    detail: "Ethnic, casual, shirts and formal wear",
    item: getCatalogueItem("navy-embroidered-jacket-kurta"),
    support: [getCatalogueItem("white-overshirt"), getCatalogueItem("navy-pinstripe-suit")],
  },
  {
    label: "Occasion",
    href: "/occasion",
    detail: "Celebration looks across the family",
    item: getCatalogueItem("champagne-sherwani-set"),
    support: [getCatalogueItem("mustard-sharara-set"), getCatalogueItem("black-bandhgala")],
  },
];

function cropStyle(item: CatalogueItem) {
  return `--crop-x: ${item.crop.x}%; --crop-y: ${item.crop.y}%; --crop-scale: ${item.crop.scale};`;
}
---

<section class="category-window page-section" id="category-window" data-reveal-section aria-labelledby="category-window-title">
  <div class="category-window__inner container">
    <header class="category-window__heading">
      <p class="folio-label" data-reveal="eyebrow">Shop by department</p>
      <div>
        <h2 class="section-title" id="category-window-title" data-reveal="title">
          A curated wardrobe in four chapters.
        </h2>
      </div>
    </header>

    <nav class="category-window__ribbon" aria-label="Catalogue categories" data-lenis-prevent>
      <a href="/sarees" data-stagger-item>Sarees</a>
      <span class="category-window__divider" aria-hidden="true">/</span>
      <a href="/occasion" data-stagger-item>Occasion & Bridal</a>
      <span class="category-window__divider" aria-hidden="true">/</span>
      <a href="/men" data-stagger-item>Menswear</a>
      <span class="category-window__divider" aria-hidden="true">/</span>
      <a href="/women" data-stagger-item>Handloom Cottons</a>
    </nav>
  </div>
</section>

<style>
  .category-window {
    overflow: hidden;
    border-top: 1px solid var(--color-line);
    background: #F7F1EA;
  }

  .category-window__inner {
    display: grid;
    gap: clamp(1.9rem, 4vw, 3.2rem);
  }

  .category-window__heading {
    display: grid;
    align-items: end;
    gap: clamp(1.5rem, 4vw, 4rem);
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
  }

  .category-window__ribbon {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.55rem 1.25rem;
    padding: 1.1rem 0 0;
    color: #2E0B11;
    font-family: var(--font-sans);
    font-size: 0.74rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .category-window__ribbon a {
    color: #2E0B11;
    text-decoration: none;
    transition: color 180ms var(--ease-out), opacity 180ms var(--ease-out);
  }

  .category-window__ribbon a:hover,
  .category-window__ribbon a:focus-visible {
    color: #7A1E25;
  }

  .category-window__divider {
    color: #A48A69;
    opacity: 0.8;
  }

  @media (max-width: 64rem) {
    .category-window__heading {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 47.99rem) {
    .category-window {
      padding-block: clamp(3.3rem, 10vw, 4.6rem);
    }

    .category-window__ribbon {
      justify-content: flex-start;
      gap: 0.5rem 0.8rem;
      font-size: 0.62rem;
      letter-spacing: 0.12em;
    }
      grid-auto-columns: minmax(12.75rem, 64vw);
    }

    .category-window__menu a {
      min-height: 6.7rem;
      border: 1px solid var(--color-line);
      background: var(--color-paper);
    }

    .category-window__preview {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding: 1rem var(--gutter) 0;
      background: var(--color-ivory);
      grid-auto-columns: minmax(13.2rem, 64vw);
      grid-auto-flow: column;
      grid-template-columns: none;
      grid-template-rows: none;
    }

    .category-panel,
    .category-panel--lead {
      scroll-snap-align: start;
      border: 1px solid var(--color-line);
      grid-column: auto;
      grid-row: auto;
    }

    .category-panel__image,
    .category-panel--lead .category-panel__image {
      --asset-ratio: 4 / 5;
    }

    .category-panel__copy {
      min-height: 11rem;
      padding: 0.9rem;
    }

    .category-panel__copy ul {
      font-size: 0.82rem;
    }
  }
</style>
