---
import { Image } from "astro:assets";
import { getCatalogueItem } from "../../data/catalogue";

const bubbles = [
  { label: "Carnival Edit", href: "/occasion", item: getCatalogueItem("mustard-sharara-set") },
  { label: "Kanjeevaram Sarees", href: "/sarees", item: getCatalogueItem("designer-brocade-saree") },
  { label: "Anarkalis", href: "/women", item: getCatalogueItem("royal-blue-anarkali") },
  { label: "Kurtas", href: "/men", item: getCatalogueItem("classic-white-kurta") },
  { label: "Sherwanis", href: "/men", item: getCatalogueItem("champagne-sherwani-set") },
  { label: "Kids & Festive", href: "/occasion", item: getCatalogueItem("sparkle-pink-coord") },
];
---

<section class="story-bubbles" aria-label="Shop by story" data-reveal-section>
  <p class="story-bubbles__heading">Shop by story</p>
  <div class="story-bubbles__track no-scrollbar">
    {bubbles.map((bubble) => {
      return (
        <a class="story-bubbles__item" href={bubble.href} aria-label={bubble.label} data-stagger-item>
          <span class="story-bubbles__ring">
            {bubble.item.image && (
              <Image
                class="story-bubbles__img"
                src={bubble.item.image}
                alt=""
                widths={[160, 240]}
                sizes="(max-width: 640px) 68px, 84px"
                width={160}
                height={160}
                quality={72}
                loading="lazy"
              />
            )}
          </span>
          <span class="story-bubbles__label">{bubble.label}</span>
        </a>
      );
    })}
  </div>
</section>

<style>
  .story-bubbles {
    position: relative;
    background: var(--color-background);
    border-bottom: 1px solid var(--color-border);
  }

  .story-bubbles__heading {
    position: absolute;
    top: 0.65rem;
    left: var(--gutter);
    z-index: 1;
    color: var(--color-muted-gold);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
  }

  .story-bubbles__track {
    display: flex;
    gap: clamp(0.9rem, 2.5vw, 1.8rem);
    padding-top: 1.7rem;
    padding-bottom: 0.8rem;
    padding-inline: var(--gutter);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .story-bubbles__track::-webkit-scrollbar {
    display: none;
  }

  .story-bubbles__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
    scroll-snap-align: start;
  }

  .story-bubbles__ring {
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-card);
    transition:
      border-color 180ms var(--ease-out),
      transform 300ms var(--ease-out),
      box-shadow 300ms var(--ease-out);
  }

  @media (min-width: 64rem) {
    .story-bubbles__ring {
      width: 84px;
      height: 84px;
    }
  }

  .story-bubbles__item:hover .story-bubbles__ring {
    border-color: var(--color-maroon);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-maroon) 18%, transparent);
    transform: scale(1.05);
  }

  .story-bubbles__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .story-bubbles__label {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1.2;
    text-align: center;
    color: var(--color-description);
    max-width: 7rem;
    text-transform: none;
  }
</style>
